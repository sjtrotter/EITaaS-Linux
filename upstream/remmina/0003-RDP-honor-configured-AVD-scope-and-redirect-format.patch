From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stephen Trotter <33046718+sjtrotter@users.noreply.github.com>
Date: Sun, 30 Aug 2026 05:58:38 -0500
Subject: [PATCH 3/4] RDP: honor configured AVD scope and redirect format

---
 plugins/rdp/rdp_web_auth.c | 27 +++++++++++++++++++++++----
 1 file changed, 23 insertions(+), 4 deletions(-)

diff --git a/plugins/rdp/rdp_web_auth.c b/plugins/rdp/rdp_web_auth.c
index 53cd19a..b262341 100644
--- a/plugins/rdp/rdp_web_auth.c
+++ b/plugins/rdp/rdp_web_auth.c
@@ -78,6 +78,22 @@ static BOOL remmina_sso_mib_try_access_token(freerdp *instance, AccessTokenType
 #define GET_TOKEN_URI(gp) \
 	(gchar*) g_object_get_data(G_OBJECT(gp), "token-uri")
 
+static BOOL redirect_format_is_safe(const char* format)
+{
+	size_t substitutions = 0;
+	if (!format)
+		return FALSE;
+
+	for (const char* current = strchr(format, '%'); current;
+	     current = strchr(current + 2, '%')) {
+		if (current[1] == '%')
+			continue;
+		if (current[1] != 's' || ++substitutions > 2)
+			return FALSE;
+	}
+	return TRUE;
+}
+
 static char* extract_authorization_code(char* url)
 {
 	WINPR_ASSERT(url);
@@ -296,7 +312,8 @@ static BOOL remmina_rdp_get_avd_access_token(freerdp* instance, char** token) {
 	char* auth_uri = NULL;
 	size_t auth_uri_len = 0;
 	char* auth_hints = NULL;
-	const char* scope = "https%3A%2F%2Fwww.wvd.microsoft.com%2F.default";
+	const char* scope = freerdp_settings_get_string(instance->context->settings,
+	                                                FreeRDP_GatewayAvdScope);
 
 	assert(token);
 
@@ -314,12 +331,14 @@ static BOOL remmina_rdp_get_avd_access_token(freerdp* instance, char** token) {
 		tenantid =
 		    freerdp_settings_get_string(instance->context->settings, FreeRDP_GatewayAvdAadtenantid);
 	}
-	if (!base || !tenantid || !client_id) {
+	const char* redirect_format = freerdp_settings_get_string(
+	    instance->context->settings, FreeRDP_GatewayAvdAccessAadFormat);
+	if (!base || !tenantid || !client_id || !scope ||
+	    !redirect_format_is_safe(redirect_format)) {
 		goto cleanup;
 	}
 
-	winpr_asprintf(&redirect_uri, &redirect_uri_len,
-	               "https%%3A%%2F%%2F%s%%2F%s%%2Foauth2%%2Fnativeclient", base, tenantid);
+	winpr_asprintf(&redirect_uri, &redirect_uri_len, redirect_format, base, tenantid);
 	if (!redirect_uri) {
 		goto cleanup;
 	}
