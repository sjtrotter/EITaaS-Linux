From 9ae938d86aec0fc82f1b5c77df744f70255bfca2 Mon Sep 17 00:00:00 2001
From: Stephen Trotter <33046718+sjtrotter@users.noreply.github.com>
Date: Sun, 30 Aug 2026 12:04:23 -0500
Subject: [PATCH 3/7] RDP: honor configured AVD scope and redirect format

The WebKit AVD token path ignored FreeRDP_GatewayAvdScope and
FreeRDP_GatewayAvdAccessAadFormat and hard-coded the commercial
www.wvd.microsoft.com scope and the dynamic native-client redirect. Any
sovereign-cloud configuration was silently replaced by commercial values.

Use the configured scope and redirect format, but only after checking
that the authority, client id, tenant, scope, and redirect format form a
supported combination: the AVD public client id, a tenant made of
alphanumerics, '-' and '.', and the scope and redirect format the cloud
table in rdp_avd_cloud.h publishes for that authority, or FreeRDP's own
dynamic redirect, which every cloud accepts. Validating against the same
table the connection path selects from keeps one list of public constants
for the whole plugin. The redirect format is the format string passed to
winpr_asprintf(), so restricting it to known values also keeps untrusted
settings out of a format argument. A missing authorization endpoint now
fails instead of being formatted as NULL.

Tested with FreeRDP 3.30.0. The series requires FreeRDP 3.16.0 or
newer: FreeRDP_GatewayAvdScope and FreeRDP_GatewayAvdAccessAadFormat
were added in that release, and every other API used is older.

This change was prepared with AI assistance (Claude, Anthropic) and was
reviewed and tested by the author.
---
 plugins/rdp/rdp_avd_cloud.h | 15 ++++++++++++++
 plugins/rdp/rdp_web_auth.c  | 39 +++++++++++++++++++++++++++++++++----
 2 files changed, 50 insertions(+), 4 deletions(-)

diff --git a/plugins/rdp/rdp_avd_cloud.h b/plugins/rdp/rdp_avd_cloud.h
index f600ddb3a..196b690a4 100644
--- a/plugins/rdp/rdp_avd_cloud.h
+++ b/plugins/rdp/rdp_avd_cloud.h
@@ -78,4 +78,19 @@ static inline const RemminaAvdCloud *remmina_avd_cloud_for_gateway(const char *h
 	return NULL;
 }
 
+/* The cloud served by an OAuth authority, or NULL. Authorities are host
+ * names, so they are compared without regard to case. */
+static inline const RemminaAvdCloud *remmina_avd_cloud_for_authority(const char *authority)
+{
+	gsize count = 0;
+	const RemminaAvdCloud *clouds = remmina_avd_clouds(&count);
+
+	if (!authority)
+		return NULL;
+	for (gsize i = 0; i < count; i++)
+		if (g_ascii_strcasecmp(authority, clouds[i].authority) == 0)
+			return &clouds[i];
+	return NULL;
+}
+
 G_END_DECLS
diff --git a/plugins/rdp/rdp_web_auth.c b/plugins/rdp/rdp_web_auth.c
index 53cd19af3..cf9866383 100644
--- a/plugins/rdp/rdp_web_auth.c
+++ b/plugins/rdp/rdp_web_auth.c
@@ -58,6 +58,7 @@ static BOOL remmina_sso_mib_try_access_token(freerdp *instance, AccessTokenType
 #endif
 
 #ifdef WITH_RDP_AUTH_AAD
+#include "rdp_avd_cloud.h"
 #include "rdp_plugin.h"
 #include <webkit2/webkit2.h>
 #include <freerdp/utils/aad.h>
@@ -78,6 +79,32 @@ static BOOL remmina_sso_mib_try_access_token(freerdp *instance, AccessTokenType
 #define GET_TOKEN_URI(gp) \
 	(gchar*) g_object_get_data(G_OBJECT(gp), "token-uri")
 
+/*
+ * The authority, tenant, client id, scope, and redirect format must form a
+ * combination one supported cloud publishes. The redirect format is passed to
+ * winpr_asprintf(), so restricting it to the table's literals also keeps
+ * untrusted settings out of a format argument.
+ */
+static BOOL avd_oauth_settings_are_safe(const char *base, const char *tenantid,
+					const char *client_id, const char *scope,
+					const char *redirect_format)
+{
+	static const char avd_client_id[] = "a85cf173-4192-42f8-81fa-777a763e6e2c";
+	const RemminaAvdCloud *cloud = remmina_avd_cloud_for_authority(base);
+
+	if (!cloud || !tenantid || !client_id || !scope || !redirect_format)
+		return FALSE;
+	if (strcmp(client_id, avd_client_id) != 0 || strlen(tenantid) > 128)
+		return FALSE;
+	for (const char *current = tenantid; *current; current++)
+		if (!g_ascii_isalnum(*current) && *current != '-' && *current != '.')
+			return FALSE;
+	if (strcmp(scope, cloud->scope) != 0)
+		return FALSE;
+	return strcmp(redirect_format, cloud->redirect_format) == 0 ||
+	       strcmp(redirect_format, REMMINA_AVD_REDIRECT_DYNAMIC) == 0;
+}
+
 static char* extract_authorization_code(char* url)
 {
 	WINPR_ASSERT(url);
@@ -296,7 +323,8 @@ static BOOL remmina_rdp_get_avd_access_token(freerdp* instance, char** token) {
 	char* auth_uri = NULL;
 	size_t auth_uri_len = 0;
 	char* auth_hints = NULL;
-	const char* scope = "https%3A%2F%2Fwww.wvd.microsoft.com%2F.default";
+	const char *scope = freerdp_settings_get_string(instance->context->settings,
+							FreeRDP_GatewayAvdScope);
 
 	assert(token);
 
@@ -314,18 +342,21 @@ static BOOL remmina_rdp_get_avd_access_token(freerdp* instance, char** token) {
 		tenantid =
 		    freerdp_settings_get_string(instance->context->settings, FreeRDP_GatewayAvdAadtenantid);
 	}
-	if (!base || !tenantid || !client_id) {
+	const char *redirect_format = freerdp_settings_get_string(
+		instance->context->settings, FreeRDP_GatewayAvdAccessAadFormat);
+	if (!avd_oauth_settings_are_safe(base, tenantid, client_id, scope, redirect_format)) {
 		goto cleanup;
 	}
 
-	winpr_asprintf(&redirect_uri, &redirect_uri_len,
-	               "https%%3A%%2F%%2F%s%%2F%s%%2Foauth2%%2Fnativeclient", base, tenantid);
+	winpr_asprintf(&redirect_uri, &redirect_uri_len, redirect_format, base, tenantid);
 	if (!redirect_uri) {
 		goto cleanup;
 	}
 
 	const char* ep = freerdp_utils_aad_get_wellknown_string(instance->context,
 	                                                        AAD_WELLKNOWN_authorization_endpoint);
+	if (!ep)
+		goto cleanup;
 
 	auth_hints = get_auth_hints(gp);
 	if (!auth_hints) {
-- 
