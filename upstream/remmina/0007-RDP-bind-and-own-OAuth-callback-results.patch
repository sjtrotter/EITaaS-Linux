+static gboolean oauth_query_value(const gchar *query, const gchar *name, gchar **value)
+{
+	*value = NULL;
+	if (!query)
+		return FALSE;
+	gchar **parts = g_strsplit(query, "&", -1);
+	for (gchar **part = parts; part && *part; part++) {
+		gchar *separator = strchr(*part, '=');
+		if (!separator)
+			continue;
+		gchar *key = g_uri_unescape_segment(*part, separator, NULL);
+		if (g_strcmp0(key, name) == 0) {
+			g_free(key);
+			if (*value) {
+				g_clear_pointer(value, g_free);
+				g_strfreev(parts);
+				return FALSE;
+			}
+			*value = g_uri_unescape_string(separator + 1, NULL);
+			continue;
+		}
+		g_free(key);
+	}
+	g_strfreev(parts);
+	return *value != NULL;
+}
+
+static gboolean oauth_callback_matches(RemminaProtocolWidget *gp, const gchar *uri)
+{
+	const gchar *expected_uri = GET_EXPECTED_REDIRECT(gp);
+	const gchar *expected_state = GET_OAUTH_STATE(gp);
+	GUri *actual = uri ? g_uri_parse(uri, G_URI_FLAGS_NONE, NULL) : NULL;
+	GUri *expected = expected_uri ? g_uri_parse(expected_uri, G_URI_FLAGS_NONE, NULL) : NULL;
+	gchar *state = NULL;
+	gchar *code = NULL;
+	gchar *oauth_error = NULL;
+	gboolean destination = actual && expected && g_uri_get_scheme(actual) &&
+		g_uri_get_scheme(expected) && g_uri_get_host(actual) && g_uri_get_host(expected) &&
+		g_ascii_strcasecmp(g_uri_get_scheme(actual), g_uri_get_scheme(expected)) == 0 &&
+		g_ascii_strcasecmp(g_uri_get_host(actual), g_uri_get_host(expected)) == 0 &&
+		g_uri_get_port(actual) == g_uri_get_port(expected) &&
+		g_strcmp0(g_uri_get_path(actual), g_uri_get_path(expected)) == 0 &&
+		g_uri_get_userinfo(actual) == NULL && g_uri_get_fragment(actual) == NULL;
+	gboolean state_ok = destination && oauth_query_value(g_uri_get_query(actual), "state", &state) &&
+		g_strcmp0(state, expected_state) == 0;
+	gboolean result = state_ok &&
+		(oauth_query_value(g_uri_get_query(actual), "code", &code) ||
+		 oauth_query_value(g_uri_get_query(actual), "error", &oauth_error));
+	g_free(state);
+	g_free(code);
+	g_free(oauth_error);
+	if (actual)
+		g_uri_unref(actual);
+	if (expected)
+		g_uri_unref(expected);
+	return result;
+}
+
+static gboolean oauth_pkce_new(gchar **state, gchar **verifier, gchar **challenge)
+{
+	guchar random_state[32];
+	guchar random_verifier[32];
+	if (winpr_RAND(random_state, sizeof(random_state)) < 0 ||
+	    winpr_RAND(random_verifier, sizeof(random_verifier)) < 0)
+		return FALSE;
+	*state = crypto_base64url_encode(random_state, sizeof(random_state));
+	*verifier = crypto_base64url_encode(random_verifier, sizeof(random_verifier));
+	if (!*state || !*verifier)
+		return FALSE;
+	guint8 digest[32];
+	gsize digest_length = sizeof(digest);
+	GChecksum *checksum = g_checksum_new(G_CHECKSUM_SHA256);
+	g_checksum_update(checksum, (const guchar *)*verifier, strlen(*verifier));
+	g_checksum_get_digest(checksum, digest, &digest_length);
+	g_checksum_free(checksum);
+	*challenge = crypto_base64url_encode(digest, digest_length);
+	return *challenge != NULL;
+}
