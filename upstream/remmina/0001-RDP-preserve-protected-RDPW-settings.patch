diff --git a/plugins/rdp/rdp_rdpw.c b/plugins/rdp/rdp_rdpw.c
new file mode 100644
index 000000000..006200a51
--- /dev/null
+++ b/plugins/rdp/rdp_rdpw.c
@@ -0,0 +1,254 @@
+/*
+ * Remmina - The GTK+ Remote Desktop Client
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+/*
+ * Protected connection files (.rdpw) published by Azure Virtual Desktop hold
+ * settings the generic .rdp importer does not model. The helpers here are the
+ * only place that reads such a file, decodes it, classifies it, and filters it
+ * for FreeRDP's native connection-file parser; they depend on GLib alone so
+ * that they can be exercised without a display or an RDP session.
+ */
+
+#include "rdp_rdpw.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <glib/gstdio.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+/*
+ * The GError text below reaches the log, not a dialog: the importer decides
+ * what to tell the user. Keep it short and free of profile content.
+ *
+ * Read the file at path exactly once through a descriptor opened with
+ * O_NOFOLLOW. Only a regular file of at most REMMINA_RDPW_MAX_SIZE bytes is
+ * accepted, and the size reported by fstat() must match what is read, so the
+ * caller owns an immutable copy that a later change to the file cannot alter.
+ * Returns a NUL-terminated buffer of *length bytes, or NULL with error set.
+ */
+gchar *remmina_rdpw_read_file(const gchar *path, gsize *length, GError **error)
+{
+	g_return_val_if_fail(path && length, NULL);
+	*length = 0;
+	int descriptor = g_open(path, O_RDONLY | O_CLOEXEC | O_NOFOLLOW, 0);
+	if (descriptor < 0) {
+		g_set_error(error, G_FILE_ERROR, g_file_error_from_errno(errno),
+			    "Could not open protected RDPW profile: %s", g_strerror(errno));
+		return NULL;
+	}
+	GStatBuf status;
+	if (fstat(descriptor, &status) != 0 || !S_ISREG(status.st_mode) ||
+	    status.st_size < 0 || status.st_size > REMMINA_RDPW_MAX_SIZE) {
+		g_set_error_literal(error, G_FILE_ERROR, G_FILE_ERROR_INVAL,
+				    "Protected RDPW profile is not a bounded regular file");
+		close(descriptor);
+		return NULL;
+	}
+	gsize expected = (gsize)status.st_size;
+	gchar *buffer = g_malloc(expected + 1);
+	gsize offset = 0;
+	while (offset < expected) {
+		ssize_t count = read(descriptor, buffer + offset, expected - offset);
+		if (count < 0 && errno == EINTR)
+			continue;
+		if (count < 0) {
+			g_set_error(error, G_FILE_ERROR, g_file_error_from_errno(errno),
+				    "Could not read protected RDPW profile: %s", g_strerror(errno));
+			g_free(buffer);
+			close(descriptor);
+			return NULL;
+		}
+		if (count == 0) {
+			g_set_error_literal(error, G_FILE_ERROR, G_FILE_ERROR_FAILED,
+					    "Protected RDPW profile changed while being read");
+			g_free(buffer);
+			close(descriptor);
+			return NULL;
+		}
+		offset += (gsize)count;
+	}
+	gchar extra;
+	ssize_t extra_count = read(descriptor, &extra, 1);
+	close(descriptor);
+	if (extra_count != 0) {
+		g_set_error_literal(error, G_FILE_ERROR, G_FILE_ERROR_FAILED,
+				    "Protected RDPW profile changed while being read");
+		g_free(buffer);
+		return NULL;
+	}
+	buffer[offset] = '\0';
+	*length = offset;
+	return buffer;
+}
+
+/*
+ * Decode one buffer holding a connection file into UTF-8. Windows writes these
+ * files as UTF-16 with a byte-order mark; anything else is taken as UTF-8.
+ * Returns NULL when the bytes are not valid text in the encoding they claim.
+ */
+gchar *remmina_rdpw_to_utf8(const gchar *contents, gsize length)
+{
+	const gchar *encoding = NULL;
+	gsize written = 0;
+	gchar *utf8 = NULL;
+
+	g_return_val_if_fail(contents || length == 0, NULL);
+
+	if (length >= 2 && (guchar)contents[0] == 0xFF && (guchar)contents[1] == 0xFE)
+		encoding = "UTF-16LE";
+	else if (length >= 2 && (guchar)contents[0] == 0xFE && (guchar)contents[1] == 0xFF)
+		encoding = "UTF-16BE";
+	if (!encoding) {
+		/* g_utf8_validate() with a length also rejects an embedded NUL. */
+		if (!g_utf8_validate(contents, length, NULL))
+			return NULL;
+		return g_strndup(contents, length);
+	}
+	utf8 = g_convert(contents + 2, length - 2, "UTF-8", encoding, NULL, &written, NULL);
+	/*
+	 * Everything downstream treats the result as a C string, so a NUL in the
+	 * middle of it would silently drop every setting behind it.
+	 */
+	if (utf8 && strlen(utf8) != written) {
+		g_free(utf8);
+		return NULL;
+	}
+	return utf8;
+}
+
+/*
+ * Split the text into lines the way FreeRDP's connection-file parser does:
+ * on CR as well as LF. Splitting on LF alone would leave a carriage return
+ * inside a line, so one line could carry settings that the caller never
+ * inspects but the parser would still act on. Everything that reads a
+ * protected file — the importer included — splits it through here, so all of
+ * them see the same lines. Empty elements are expected (CRLF produces one)
+ * and are dropped by the callers, which need a "key:type:value" line.
+ */
+gchar **remmina_rdpw_split_lines(const gchar *utf8)
+{
+	return g_strsplit_set(utf8, "\r\n", -1);
+}
+
+/* Split "key:type:value"; returns the key, or NULL when the line has no value. */
+static gchar *rdpw_split_line(const gchar *line, const gchar **value)
+{
+	const gchar *first = strchr(line, ':');
+
+	*value = NULL;
+	if (!first)
+		return NULL;
+	const gchar *second = strchr(first + 1, ':');
+	if (!second)
+		return NULL;
+	*value = second + 1;
+	return g_strndup(line, first - line);
+}
+
+/*
+ * Tell an AVD connection file from an ordinary one. AVD publishes the ARM
+ * resource provider together with the gateway host that serves the workspace;
+ * an ARM file without that host names no gateway to reach and can only fail
+ * at connection time, so the caller rejects it while importing.
+ */
+RemminaRdpwKind remmina_rdpw_classify(const gchar *utf8)
+{
+	gboolean arm = FALSE;
+	gboolean gateway = FALSE;
+
+	g_return_val_if_fail(utf8, REMMINA_RDPW_GENERIC);
+	gchar **lines = remmina_rdpw_split_lines(utf8);
+	for (gchar **line = lines; line && *line; line++) {
+		const gchar *value = NULL;
+		gchar *key = rdpw_split_line(g_strchomp(*line), &value);
+
+		if (!key)
+			continue;
+		if (g_ascii_strcasecmp(key, "resourceprovider") == 0 &&
+		    g_ascii_strcasecmp(value, "arm") == 0)
+			arm = TRUE;
+		else if (g_ascii_strcasecmp(key, "gatewayhostname") == 0 && *value)
+			gateway = TRUE;
+		g_free(key);
+	}
+	g_strfreev(lines);
+	if (!arm)
+		return REMMINA_RDPW_GENERIC;
+	return gateway ? REMMINA_RDPW_AVD : REMMINA_RDPW_AVD_WITHOUT_GATEWAY;
+}
+
+static gboolean rdpw_native_key_allowed(const gchar *key)
+{
+	static const gchar *const allowed[] = {
+		"full address",
+		"alternate full address",
+		"server port",
+		"loadbalanceinfo",
+		"gatewayhostname",
+		"gatewayusagemethod",
+		"gatewayprofileusagemethod",
+		"gatewaycredentialssource",
+		"promptcredentialonce",
+		"resourceprovider",
+		"wvd endpoint pool",
+		"geo",
+		"armpath",
+		"aadtenantid",
+		"diagnosticserviceurl",
+		"hubdiscoverygeourl",
+		"activityhint",
+		"enablerdsaadauth",
+		"authentication level",
+		"remoteapplicationmode",
+		"remoteapplicationprogram",
+		"remoteapplicationname",
+		"remoteapplicationguid",
+		NULL
+	};
+
+	for (gsize i = 0; allowed[i]; i++)
+		if (g_ascii_strcasecmp(key, allowed[i]) == 0)
+			return TRUE;
+	return FALSE;
+}
+
+/*
+ * Keep only the AVD routing and authentication keys FreeRDP's native
+ * connection-file parser needs. Every other line, including any line starting
+ * with '/', which FreeRDP would treat as an embedded command-line argument, is
+ * refused: a '/' line fails the whole buffer, anything else is dropped.
+ * Returns the filtered text of *filtered_length bytes, or NULL on refusal.
+ */
+gchar *remmina_rdpw_filter_native_settings(const gchar *utf8, gsize *filtered_length)
+{
+	g_return_val_if_fail(utf8 && filtered_length, NULL);
+	GString *filtered = g_string_sized_new(strlen(utf8));
+	gchar **lines = remmina_rdpw_split_lines(utf8);
+	gboolean refused = FALSE;
+
+	for (gchar **line = lines; line && *line; line++) {
+		g_strchomp(*line);
+		if ((*line)[0] == '/') {
+			refused = TRUE;
+			break;
+		}
+		const gchar *value = NULL;
+		gchar *key = rdpw_split_line(*line, &value);
+		if (!key)
+			continue;
+		if (rdpw_native_key_allowed(key))
+			g_string_append_printf(filtered, "%s\n", *line);
+		g_free(key);
+	}
+	g_strfreev(lines);
+	if (refused) {
+		g_string_free(filtered, TRUE);
+		return NULL;
+	}
+	*filtered_length = filtered->len;
+	return g_string_free(filtered, FALSE);
+}
diff --git a/plugins/rdp/rdp_rdpw.h b/plugins/rdp/rdp_rdpw.h
new file mode 100644
index 000000000..199f763b1
--- /dev/null
+++ b/plugins/rdp/rdp_rdpw.h
@@ -0,0 +1,30 @@
+/*
+ * Remmina - The GTK+ Remote Desktop Client
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#pragma once
+
+#include <glib.h>
+
+G_BEGIN_DECLS
+
+/* A protected connection file is read once and never mapped or streamed. */
+#define REMMINA_RDPW_MAX_SIZE (1024 * 1024)
+
+typedef enum {
+	/* No ARM resource provider: an ordinary connection file. */
+	REMMINA_RDPW_GENERIC = 0,
+	/* ARM resource provider and a gateway host: an AVD connection file. */
+	REMMINA_RDPW_AVD,
+	/* ARM resource provider without a gateway host: unusable. */
+	REMMINA_RDPW_AVD_WITHOUT_GATEWAY
+} RemminaRdpwKind;
+
+gchar *remmina_rdpw_read_file(const gchar *path, gsize *length, GError **error);
+gchar *remmina_rdpw_to_utf8(const gchar *contents, gsize length);
+gchar **remmina_rdpw_split_lines(const gchar *utf8);
+RemminaRdpwKind remmina_rdpw_classify(const gchar *utf8);
+gchar *remmina_rdpw_filter_native_settings(const gchar *utf8, gsize *filtered_length);
+
+G_END_DECLS
-- 
