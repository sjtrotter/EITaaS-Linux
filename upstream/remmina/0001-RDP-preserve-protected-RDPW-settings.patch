+static RemminaFile *remmina_rdp_file_import_utf8(const gchar *utf8)
+{
+	RemminaFile *remminafile = remmina_plugin_service->file_new();
+	gchar **lines = remmina_rdpw_split_lines(utf8);
+
+	for (gchar **line = lines; line && *line; line++) {
+		g_strchomp(*line);
+		gchar *first = strchr(*line, ':');
+		if (!first)
+			continue;
+		*first++ = '\0';
+		gchar *second = strchr(first, ':');
+		if (second)
+			remmina_rdp_file_import_field(remminafile, *line, second + 1);
+	}
+	g_strfreev(lines);
+
+	remmina_plugin_service->file_set_string(remminafile, "name",
+						remmina_plugin_service->file_get_string(remminafile, "server"));
+	remmina_plugin_service->file_set_string(remminafile, "protocol", "RDP");
+	return remminafile;
+}
+
 RemminaFile *remmina_rdp_file_import(RemminaFilePlugin *plugin,const gchar *from_file)
 {
 	TRACE_CALL(__func__);
 	GIOChannel *channel;
 	GError *error = NULL;
 	RemminaFile *remminafile;
+	const gchar *extension = strrchr(from_file, '.');
+
+	if (extension && g_ascii_strcasecmp(extension, ".rdpw") == 0) {
+		gsize length = 0;
+		gchar *contents = remmina_rdpw_read_file(from_file, &length, &error);
+
+		if (!contents) {
+			REMMINA_PLUGIN_WARNING("%s", error->message);
+			g_clear_error(&error);
+			return NULL;
+		}
+		gchar *utf8 = remmina_rdpw_to_utf8(contents, length);
+		if (!utf8) {
+			REMMINA_PLUGIN_WARNING("%s", _("This connection file is not valid UTF-8 or UTF-16 text."));
+			g_free(contents);
+			return NULL;
+		}
+		RemminaRdpwKind kind = remmina_rdpw_classify(utf8);
+		if (kind == REMMINA_RDPW_AVD_WITHOUT_GATEWAY) {
+			REMMINA_PLUGIN_WARNING("%s", _("This is not an Azure Virtual Desktop connection file: "
+						       "it selects the ARM resource provider but names no gateway host."));
+			g_free(utf8);
+			g_free(contents);
+			return NULL;
+		}
+		remminafile = remmina_rdp_file_import_utf8(utf8);
+		gchar *encoded = g_base64_encode((const guchar *)contents, length);
+		remmina_plugin_service->file_set_string(remminafile, "rdpw_data", encoded);
+		if (kind == REMMINA_RDPW_AVD)
+			remmina_plugin_service->file_set_string(remminafile, "gwtransp", "arm");
+		g_free(encoded);
+		g_free(utf8);
+		g_free(contents);
+		return remminafile;
+	}
 
 	channel = g_io_channel_new_file(from_file, "r", &error);
 
 	if (channel == NULL) {
 		g_print("Failed to import %s: %s\n", from_file, error->message);
+		g_clear_error(&error);
 		return NULL;
 	}
 
