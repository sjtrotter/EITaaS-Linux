 }
 
+static RemminaFile *remmina_rdp_file_import_buffer(const gchar *contents, gsize length)
+{
+	const gchar *source = contents;
+	gsize source_length = length;
+	gchar *utf8 = NULL;
+	GError *error = NULL;
+
+	if (length >= 2 && (guchar)contents[0] == 0xFF && (guchar)contents[1] == 0xFE) {
+		source = contents + 2;
+		source_length = length - 2;
+		utf8 = g_convert(source, source_length, "UTF-8", "UTF-16LE", NULL, NULL, &error);
+	} else if (length >= 2 && (guchar)contents[0] == 0xFE && (guchar)contents[1] == 0xFF) {
+		source = contents + 2;
+		source_length = length - 2;
+		utf8 = g_convert(source, source_length, "UTF-8", "UTF-16BE", NULL, NULL, &error);
+	} else {
+		utf8 = g_strndup(source, source_length);
+	}
+	if (!utf8) {
+		g_clear_error(&error);
+		return NULL;
+	}
+
+	RemminaFile *remminafile = remmina_plugin_service->file_new();
+	gchar **lines = g_strsplit(utf8, "\n", -1);
+	for (gchar **line = lines; line && *line; line++) {
+		g_strchomp(*line);
+		gchar *first = strchr(*line, ':');
+		if (!first)
+			continue;
+		*first++ = '\0';
+		gchar *second = strchr(first, ':');
+		if (second)
+			remmina_rdp_file_import_field(remminafile, *line, second + 1);
+	}
+	g_strfreev(lines);
+	g_free(utf8);
+
+	remmina_plugin_service->file_set_string(remminafile, "name",
+						remmina_plugin_service->file_get_string(remminafile, "server"));
+	remmina_plugin_service->file_set_string(remminafile, "protocol", "RDP");
+	return remminafile;
+}
+
 RemminaFile *remmina_rdp_file_import(RemminaFilePlugin *plugin,const gchar *from_file)
 {
 	TRACE_CALL(__func__);
 	GIOChannel *channel;
 	GError *error = NULL;
 	RemminaFile *remminafile;
+	const gchar *extension = strrchr(from_file, '.');
+	gboolean protected_profile = extension && g_ascii_strcasecmp(extension, ".rdpw") == 0;
+	gchar *protected_contents = NULL;
+	gsize protected_length = 0;
+	gchar *protected_encoded = NULL;
+
+	if (protected_profile) {
+		if (!remmina_rdp_file_read_protected(from_file, &protected_contents,
+						     &protected_length, &error)) {
+			g_clear_error(&error);
+			g_free(protected_contents);
+			return NULL;
+		}
+		protected_encoded = g_base64_encode((const guchar *)protected_contents, protected_length);
+		remminafile = remmina_rdp_file_import_buffer(protected_contents, protected_length);
+		if (remminafile) {
+			remmina_plugin_service->file_set_string(remminafile, "rdpw_data", protected_encoded);
+			remmina_plugin_service->file_set_string(remminafile, "gwtransp", "arm");
+		}
+		g_free(protected_contents);
+		g_free(protected_encoded);
+		return remminafile;
+	}
 
 	channel = g_io_channel_new_file(from_file, "r", &error);
 
 	if (channel == NULL) {
 		g_print("Failed to import %s: %s\n", from_file, error->message);
+		g_clear_error(&error);
 		return NULL;
 	}
 
