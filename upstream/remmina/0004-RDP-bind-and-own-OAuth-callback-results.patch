+static gboolean oauth_pkce_new(gchar **state, gchar **verifier, gchar **challenge)
+{
+	guchar random_state[32];
+	guchar random_verifier[32];
+
+	if (winpr_RAND(random_state, sizeof(random_state)) < 0 ||
+	    winpr_RAND(random_verifier, sizeof(random_verifier)) < 0)
+		return FALSE;
+	*state = crypto_base64url_encode(random_state, sizeof(random_state));
+	*verifier = crypto_base64url_encode(random_verifier, sizeof(random_verifier));
+	if (!*state || !*verifier)
+		return FALSE;
+	guint8 digest[32];
+	gsize digest_length = sizeof(digest);
+	GChecksum *checksum = g_checksum_new(G_CHECKSUM_SHA256);
+	g_checksum_update(checksum, (const guchar *)*verifier, strlen(*verifier));
+	g_checksum_get_digest(checksum, digest, &digest_length);
+	g_checksum_free(checksum);
+	*challenge = crypto_base64url_encode(digest, digest_length);
+	return *challenge != NULL;
+}
 
