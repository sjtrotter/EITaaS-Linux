From 533468ec0b057996da259564843d84a6676d28c8 Mon Sep 17 00:00:00 2001
From: Stephen Trotter <33046718+sjtrotter@users.noreply.github.com>
Date: Sun, 30 Aug 2026 09:00:56 -0500
Subject: [PATCH] RDP: make certificate loading asynchronous

Loading a PKCS #11 certificate with g_tls_certificate_new_from_pkcs11_uris()
talks to the smart card and can block for a long time when the reader or
token stalls. Run it in a GTask thread behind a modal progress dialog with
the same bounded timeout as discovery, so the GTK main thread stays
responsive and the user can cancel.

Both cancellation and timeout are terminal: the user sees a clear error
when the load timed out or failed, the challenge is cancelled exactly once
by the caller, and the load state is marked abandoned so the completion
callback only releases its own allocation and never touches the destroyed
dialog, the toplevel, or the request. The loader thread itself cannot be
interrupted because the GLib API has no cancellable; a timed-out thread
finishes on its own and is then discarded.

Certificate-PIN prompts are now bound to a certificate transaction that
records the accepted challenge host and the selected certificate, expires
after two minutes, and accepts a second PIN only for a WebKit retry. The
transaction state is re-read after the PIN dialog's nested main loop so a
challenge that replaced it meanwhile cannot leave a dangling pointer.

The toplevel reference taken by the handler covers the new nested loop as
well, and a window destroyed while the certificate was loading cancels the
challenge instead of reusing the window.

Generated with AI assistance (Claude); reviewed and tested by the author.
---
 plugins/rdp/rdp_web_auth_pkcs11.c | 193 ++++++++++++++++++++++++++++--
 1 file changed, 181 insertions(+), 12 deletions(-)

diff --git a/plugins/rdp/rdp_web_auth_pkcs11.c b/plugins/rdp/rdp_web_auth_pkcs11.c
index 07b3d99a3..2548bb9b4 100644
--- a/plugins/rdp/rdp_web_auth_pkcs11.c
+++ b/plugins/rdp/rdp_web_auth_pkcs11.c
@@ -34,6 +34,28 @@ typedef struct {
 	gboolean timed_out;
 } RemminaCertificateDiscovery;
 
+typedef struct {
+	gchar *certificate_uri;
+	gchar *private_key_uri;
+} RemminaCertificateLoadInput;
+
+typedef struct {
+	GtkWidget *dialog;
+	GTlsCertificate *certificate;
+	gchar *error_message;
+	guint timeout_source;
+	gboolean abandoned;
+	gboolean completed;
+	gboolean timed_out;
+} RemminaCertificateLoad;
+
+typedef struct {
+	gchar *host;
+	gchar *certificate_uri;
+	gint64 expires_at;
+	gboolean pin_submitted;
+} RemminaCertificateAuthState;
+
 typedef struct {
 	GtkWindow *held;
 	GtkWindow *window;
@@ -42,6 +64,21 @@ typedef struct {
 
 static gint discovery_active = 0;
 
+static void certificate_auth_state_free(gpointer data)
+{
+	RemminaCertificateAuthState *state = data;
+	if (!state)
+		return;
+	g_free(state->host);
+	g_free(state->certificate_uri);
+	g_free(state);
+}
+
+static void certificate_auth_state_clear(WebKitWebView *web_view)
+{
+	g_object_set_data(G_OBJECT(web_view), "rdp-certificate-transaction", NULL);
+}
+
 static void auth_toplevel_destroyed(GtkWidget *widget, gpointer user_data)
 {
 	(void)widget;
@@ -78,6 +115,130 @@ static void show_error(RemminaAuthToplevel *toplevel, const gchar *message)
 	gtk_widget_destroy(dialog);
 }
 
+static void certificate_load_input_free(gpointer data)
+{
+	RemminaCertificateLoadInput *input = data;
+	if (!input)
+		return;
+	g_free(input->certificate_uri);
+	g_free(input->private_key_uri);
+	g_free(input);
+}
+
+static void certificate_load_free(RemminaCertificateLoad *load)
+{
+	if (!load)
+		return;
+	if (load->timeout_source)
+		g_source_remove(load->timeout_source);
+	g_clear_object(&load->certificate);
+	g_free(load->error_message);
+	g_free(load);
+}
+
+static gboolean certificate_load_timeout(gpointer user_data)
+{
+	RemminaCertificateLoad *load = user_data;
+	load->timeout_source = 0;
+	load->timed_out = TRUE;
+	if (load->dialog)
+		gtk_dialog_response(GTK_DIALOG(load->dialog), GTK_RESPONSE_REJECT);
+	return G_SOURCE_REMOVE;
+}
+
+static void certificate_load_thread(GTask *task, gpointer source, gpointer task_data,
+	                                GCancellable *cancellable)
+{
+	(void)source;
+	(void)cancellable;
+	RemminaCertificateLoadInput *input = task_data;
+	GError *error = NULL;
+	GTlsCertificate *certificate = g_tls_certificate_new_from_pkcs11_uris(
+		input->certificate_uri, input->private_key_uri, &error);
+	if (certificate)
+		g_task_return_pointer(task, certificate, g_object_unref);
+	else if (error)
+		g_task_return_error(task, error);
+	else
+		g_task_return_new_error(task, G_IO_ERROR, G_IO_ERROR_FAILED,
+		                        "The selected smart-card certificate could not be loaded");
+}
+
+/*
+ * Runs on the GTK thread once the loader thread finishes. When the dialog was
+ * abandoned (cancelled or timed out) the load owns nothing but itself, so it
+ * is released here without touching the dialog, the toplevel, or the request.
+ */
+static void certificate_load_done(GObject *source, GAsyncResult *result, gpointer user_data)
+{
+	(void)source;
+	RemminaCertificateLoad *load = user_data;
+	GError *error = NULL;
+	load->certificate = g_task_propagate_pointer(G_TASK(result), &error);
+	load->completed = TRUE;
+	if (error)
+		load->error_message = g_strdup(error->message);
+	g_clear_error(&error);
+	if (load->abandoned) {
+		certificate_load_free(load);
+		return;
+	}
+	gtk_dialog_response(GTK_DIALOG(load->dialog),
+	                    load->certificate ? GTK_RESPONSE_ACCEPT : GTK_RESPONSE_REJECT);
+}
+
+/*
+ * Load the selected certificate away from the GTK thread while a cancellable
+ * progress dialog runs. Returns a new reference or NULL; every NULL return
+ * has already shown its error (unless the user cancelled) and leaves exactly
+ * one challenge cancellation to the caller.
+ */
+static GTlsCertificate *load_certificate_async(RemminaAuthToplevel *toplevel,
+	                                           const RemminaPkcs11Certificate *choice)
+{
+	RemminaCertificateLoad *load = g_new0(RemminaCertificateLoad, 1);
+	load->dialog = gtk_dialog_new_with_buttons(
+		"Loading smart-card certificate", toplevel->window, GTK_DIALOG_MODAL,
+		"Cancel", GTK_RESPONSE_CANCEL, NULL);
+	GtkWidget *box = gtk_box_new(GTK_ORIENTATION_HORIZONTAL, 12);
+	GtkWidget *spinner = gtk_spinner_new();
+	gtk_spinner_start(GTK_SPINNER(spinner));
+	gtk_box_pack_start(GTK_BOX(box), spinner, FALSE, FALSE, 0);
+	gtk_box_pack_start(GTK_BOX(box), gtk_label_new("Loading selected certificate…"),
+	                   FALSE, FALSE, 0);
+	gtk_container_set_border_width(GTK_CONTAINER(box), 12);
+	gtk_container_add(GTK_CONTAINER(gtk_dialog_get_content_area(GTK_DIALOG(load->dialog))), box);
+	gtk_widget_show_all(load->dialog);
+
+	RemminaCertificateLoadInput *input = g_new0(RemminaCertificateLoadInput, 1);
+	input->certificate_uri = g_strdup(choice->certificate_uri);
+	input->private_key_uri = g_strdup(choice->private_key_uri);
+	GTask *task = g_task_new(NULL, NULL, certificate_load_done, load);
+	g_task_set_task_data(task, input, certificate_load_input_free);
+	g_task_run_in_thread(task, certificate_load_thread);
+	g_object_unref(task);
+	load->timeout_source = g_timeout_add_seconds(PKCS11_TIMEOUT_SECONDS,
+	                                             certificate_load_timeout, load);
+
+	gint response = gtk_dialog_run(GTK_DIALOG(load->dialog));
+	gtk_widget_destroy(load->dialog);
+	load->dialog = NULL;
+	if (response != GTK_RESPONSE_ACCEPT || !load->certificate || !toplevel->window) {
+		const gchar *message = load->timed_out
+		                       ? "Loading the smart-card certificate timed out" : load->error_message;
+		if (message && toplevel->window)
+			show_error(toplevel, message);
+		if (load->completed)
+			certificate_load_free(load);
+		else
+			load->abandoned = TRUE;
+		return NULL;
+	}
+	GTlsCertificate *certificate = g_steal_pointer(&load->certificate);
+	certificate_load_free(load);
+	return certificate;
+}
+
 static void certificate_free(gpointer data)
 {
 	RemminaPkcs11Certificate *cert = data;
@@ -365,6 +526,7 @@ gboolean remmina_rdp_webview_pkcs11_authenticate(WebKitWebView *web_view,
 	RemminaAuthToplevel toplevel = { 0 };
 	auth_toplevel_hold(&toplevel, parent_data);
 	if (scheme == WEBKIT_AUTHENTICATION_SCHEME_CLIENT_CERTIFICATE_REQUESTED) {
+		certificate_auth_state_clear(web_view);
 		const gchar *request_host = trusted_request_host(web_view, request);
 		if (!request_host) {
 			webkit_authentication_request_cancel(request);
@@ -404,21 +566,22 @@ gboolean remmina_rdp_webview_pkcs11_authenticate(WebKitWebView *web_view,
 			response = GTK_RESPONSE_CANCEL;
 		if (response == GTK_RESPONSE_ACCEPT && selected >= 0 && (guint)selected < certs->len) {
 			RemminaPkcs11Certificate *choice = g_ptr_array_index(certs, selected);
-			GError *error = NULL;
-			GTlsCertificate *certificate = g_tls_certificate_new_from_pkcs11_uris(
-			    choice->certificate_uri, choice->private_key_uri, &error);
+			GTlsCertificate *certificate = load_certificate_async(&toplevel, choice);
 			if (certificate) {
+				RemminaCertificateAuthState *state = g_new0(RemminaCertificateAuthState, 1);
+				state->host = g_strdup(request_host);
+				state->certificate_uri = g_strdup(choice->certificate_uri);
+				state->expires_at = g_get_monotonic_time() + (2 * G_TIME_SPAN_MINUTE);
+				g_object_set_data_full(G_OBJECT(web_view), "rdp-certificate-transaction",
+				                       state, certificate_auth_state_free);
 				WebKitCredential *credential = webkit_credential_new_for_certificate(
 				    certificate, WEBKIT_CREDENTIAL_PERSISTENCE_NONE);
-				g_object_set_data_full(G_OBJECT(web_view), "rdp-certificate-host",
-				                       g_strdup(request_host), g_free);
 				webkit_authentication_request_authenticate(request, credential);
 				webkit_credential_free(credential);
 				g_object_unref(certificate);
 			} else {
 				webkit_authentication_request_cancel(request);
 			}
-			g_clear_error(&error);
 		} else {
 			webkit_authentication_request_cancel(request);
 		}
@@ -428,10 +591,14 @@ gboolean remmina_rdp_webview_pkcs11_authenticate(WebKitWebView *web_view,
 		return TRUE;
 	}
 	const gchar *request_host = trusted_request_host(web_view, request);
-	const gchar *certificate_host = g_object_get_data(G_OBJECT(web_view),
-	                                                   "rdp-certificate-host");
-	if (!request_host || !certificate_host ||
-	    g_ascii_strcasecmp(request_host, certificate_host) != 0) {
+	RemminaCertificateAuthState *state = g_object_get_data(
+		G_OBJECT(web_view), "rdp-certificate-transaction");
+	gboolean retrying = webkit_authentication_request_is_retry(request);
+	if (!request_host || !state || !state->certificate_uri ||
+	    g_get_monotonic_time() >= state->expires_at ||
+	    g_ascii_strcasecmp(request_host, state->host) != 0 ||
+	    (state->pin_submitted && !retrying)) {
+		certificate_auth_state_clear(web_view);
 		webkit_authentication_request_cancel(request);
 		auth_toplevel_release(&toplevel);
 		return TRUE;
@@ -447,16 +614,18 @@ gboolean remmina_rdp_webview_pkcs11_authenticate(WebKitWebView *web_view,
 	gtk_container_add(GTK_CONTAINER(gtk_dialog_get_content_area(GTK_DIALOG(dialog))), entry);
 	gtk_widget_show_all(dialog);
 	gint response = gtk_dialog_run(GTK_DIALOG(dialog));
-	if (response == GTK_RESPONSE_ACCEPT && toplevel.window) {
+	state = g_object_get_data(G_OBJECT(web_view), "rdp-certificate-transaction");
+	if (response == GTK_RESPONSE_ACCEPT && toplevel.window && state) {
 		WebKitCredential *credential = webkit_credential_new_for_certificate_pin(
 		    gtk_entry_get_text(GTK_ENTRY(entry)), WEBKIT_CREDENTIAL_PERSISTENCE_NONE);
 		webkit_authentication_request_authenticate(request, credential);
 		webkit_credential_free(credential);
+		state->pin_submitted = TRUE;
 	} else {
 		webkit_authentication_request_cancel(request);
+		certificate_auth_state_clear(web_view);
 	}
 	gtk_entry_set_text(GTK_ENTRY(entry), "");
-	g_object_set_data(G_OBJECT(web_view), "rdp-certificate-host", NULL);
 	gtk_widget_destroy(dialog);
 	auth_toplevel_release(&toplevel);
 	return TRUE;
-- 
