+/*
+ * Remmina - The GTK+ Remote Desktop Client
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+/*
+ * Exercise the protected connection-file helpers against a synthetic file.
+ * The fixture is a made-up Azure Virtual Desktop profile: every host, tenant,
+ * and user in it is invented, and it carries no signature.
+ */
+
+#include "rdp_rdpw.h"
+
+#include <glib/gstdio.h>
+#include <string.h>
+#include <unistd.h>
+
+static gchar *fixture_path;
+
+static gchar *read_fixture(gsize *length)
+{
+	GError *error = NULL;
+	gchar *contents = remmina_rdpw_read_file(fixture_path, length, &error);
+
+	g_assert_no_error(error);
+	g_assert_nonnull(contents);
+	return contents;
+}
+
+static void test_read_file_accepts_the_fixture(void)
+{
+	gsize length = 0;
+	gchar *contents = read_fixture(&length);
+
+	g_assert_cmpuint(length, >, 0);
+	g_assert_cmpuint(strlen(contents), ==, length);
+	g_assert_nonnull(strstr(contents, "resourceprovider:s:arm"));
+	g_free(contents);
+}
+
+static void test_read_file_refuses_a_symbolic_link(void)
+{
+	gchar *directory = g_dir_make_tmp("remmina-rdpw-XXXXXX", NULL);
+	gchar *link = g_build_filename(directory, "link.rdpw", NULL);
+	GError *error = NULL;
+	gsize length = 1;
+
+	g_assert_nonnull(directory);
+	g_assert_cmpint(symlink(fixture_path, link), ==, 0);
+	g_assert_null(remmina_rdpw_read_file(link, &length, &error));
+	g_assert_nonnull(error);
+	g_assert_cmpuint(length, ==, 0);
+	g_clear_error(&error);
+	g_assert_cmpint(g_unlink(link), ==, 0);
+	g_assert_cmpint(g_rmdir(directory), ==, 0);
+	g_free(link);
+	g_free(directory);
+}
+
+static void test_read_file_refuses_a_directory(void)
+{
+	gchar *directory = g_dir_make_tmp("remmina-rdpw-XXXXXX", NULL);
+	GError *error = NULL;
+	gsize length = 1;
+
+	g_assert_nonnull(directory);
+	g_assert_null(remmina_rdpw_read_file(directory, &length, &error));
+	g_assert_nonnull(error);
+	g_clear_error(&error);
+	g_assert_cmpint(g_rmdir(directory), ==, 0);
+	g_free(directory);
+}
+
+static void test_read_file_refuses_an_oversized_file(void)
+{
+	gchar *directory = g_dir_make_tmp("remmina-rdpw-XXXXXX", NULL);
+	gchar *path = g_build_filename(directory, "big.rdpw", NULL);
+	GError *error = NULL;
+	gsize length = 1;
+
+	g_assert_nonnull(directory);
+	g_assert_true(g_file_set_contents(path, "full address:s:host.rdp.test\n", -1, NULL));
+	g_assert_cmpint(truncate(path, REMMINA_RDPW_MAX_SIZE + 1), ==, 0);
+	g_assert_null(remmina_rdpw_read_file(path, &length, &error));
+	g_assert_nonnull(error);
+	g_assert_cmpuint(length, ==, 0);
+	g_clear_error(&error);
+
+	/* The bound itself is accepted. */
+	g_assert_cmpint(truncate(path, REMMINA_RDPW_MAX_SIZE), ==, 0);
+	gchar *contents = remmina_rdpw_read_file(path, &length, &error);
+
+	g_assert_no_error(error);
+	g_assert_nonnull(contents);
+	g_assert_cmpuint(length, ==, REMMINA_RDPW_MAX_SIZE);
+	g_free(contents);
+	g_assert_cmpint(g_unlink(path), ==, 0);
+	g_assert_cmpint(g_rmdir(directory), ==, 0);
+	g_free(path);
+	g_free(directory);
+}
+
+static void test_utf16_and_utf8_decode_alike(void)
+{
+	gsize length = 0;
+	gchar *contents = read_fixture(&length);
+	gchar *from_utf8 = remmina_rdpw_to_utf8(contents, length);
+	gsize wide_length = 0;
+	gchar *wide = g_convert(contents, length, "UTF-16LE", "UTF-8", NULL, &wide_length, NULL);
+	gchar *with_bom = g_malloc(wide_length + 2);
+
+	g_assert_nonnull(from_utf8);
+	g_assert_nonnull(wide);
+	with_bom[0] = (gchar)0xFF;
+	with_bom[1] = (gchar)0xFE;
+	memcpy(with_bom + 2, wide, wide_length);
+	gchar *from_utf16 = remmina_rdpw_to_utf8(with_bom, wide_length + 2);
+
+	g_assert_cmpstr(from_utf16, ==, from_utf8);
+	g_free(from_utf16);
+	g_free(with_bom);
+	g_free(wide);
+	g_free(from_utf8);
+	g_free(contents);
+}
+
+static void test_invalid_text_is_refused(void)
+{
+	const gchar invalid[] = { (gchar)0xC3, (gchar)0x28, '\n' };
+
+	g_assert_null(remmina_rdpw_to_utf8(invalid, sizeof(invalid)));
+}
+
+static void test_embedded_nul_text_is_refused(void)
+{
+	/* UTF-16LE with a byte-order mark: 'a', U+0000, 'b'. */
+	const gchar wide[] = { (gchar)0xFF, (gchar)0xFE, 'a', 0, 0, 0, 'b', 0 };
+
+	g_assert_null(remmina_rdpw_to_utf8(wide, sizeof(wide)));
+}
+
+static void test_classify_reads_the_routing_keys(void)
+{
+	gsize length = 0;
+	gchar *contents = read_fixture(&length);
+	gchar *utf8 = remmina_rdpw_to_utf8(contents, length);
+
+	g_assert_cmpint(remmina_rdpw_classify(utf8), ==, REMMINA_RDPW_AVD);
+	g_assert_cmpint(remmina_rdpw_classify("full address:s:host.rdp.test\n"), ==,
+			REMMINA_RDPW_GENERIC);
+	g_assert_cmpint(remmina_rdpw_classify("resourceprovider:s:ARM\n"
+					      "gatewayhostname:s:gateway.rdp.test\n"), ==,
+			REMMINA_RDPW_AVD);
+	g_assert_cmpint(remmina_rdpw_classify("resourceprovider:s:arm\n"), ==,
+			REMMINA_RDPW_AVD_WITHOUT_GATEWAY);
+	g_assert_cmpint(remmina_rdpw_classify("resourceprovider:s:arm\n"
+					      "gatewayhostname:s:\n"), ==,
+			REMMINA_RDPW_AVD_WITHOUT_GATEWAY);
+	g_free(utf8);
+	g_free(contents);
+}
+
+static void test_allowlist_keeps_only_routing_settings(void)
+{
+	gsize length = 0;
+	gchar *contents = read_fixture(&length);
+	gchar *utf8 = remmina_rdpw_to_utf8(contents, length);
+	gsize filtered_length = 0;
+	gchar *filtered = remmina_rdpw_filter_native_settings(utf8, &filtered_length);
+
+	g_assert_nonnull(filtered);
+	g_assert_cmpuint(strlen(filtered), ==, filtered_length);
+	g_assert_nonnull(strstr(filtered, "full address:s:host.rdp.test\n"));
+	g_assert_nonnull(strstr(filtered, "gatewayhostname:s:gateway.rdp.test\n"));
+	g_assert_nonnull(strstr(filtered, "resourceprovider:s:arm\n"));
+	g_assert_nonnull(strstr(filtered, "aadtenantid:s:"));
+	g_assert_null(strstr(filtered, "username"));
+	g_assert_null(strstr(filtered, "alternate shell"));
+	g_assert_null(strstr(filtered, "redirectsmartcards"));
+	g_assert_null(strstr(filtered, "screen mode id"));
+	g_free(filtered);
+	g_free(utf8);
+	g_free(contents);
+}
+
+static void test_allowlist_refuses_embedded_arguments(void)
+{
+	gsize filtered_length = 1;
+
+	g_assert_null(remmina_rdpw_filter_native_settings(
+			      "full address:s:host.rdp.test\n/v:other.rdp.test\n", &filtered_length));
+	g_assert_null(remmina_rdpw_filter_native_settings("/sec:tls\n", &filtered_length));
+}
+
+/*
+ * FreeRDP's connection-file parser splits on CR as well as LF, so a carriage
+ * return inside a line must not hide anything from the filter or from the
+ * classification.
+ */
+static void test_a_carriage_return_hides_nothing(void)
+{
+	gsize filtered_length = 1;
+
+	g_assert_null(remmina_rdpw_filter_native_settings(
+			      "gatewayhostname:s:gateway.rdp.test\r/v:other.rdp.test\n",
+			      &filtered_length));
+
+	gchar *filtered = remmina_rdpw_filter_native_settings(
+		"gatewayhostname:s:gateway.rdp.test\ralternate shell:s:hidden\r\n"
+		"resourceprovider:s:arm\r\n", &filtered_length);
+
+	g_assert_nonnull(filtered);
+	g_assert_null(strstr(filtered, "alternate shell"));
+	g_assert_null(strstr(filtered, "\r"));
+	g_assert_nonnull(strstr(filtered, "gatewayhostname:s:gateway.rdp.test\n"));
+	g_assert_nonnull(strstr(filtered, "resourceprovider:s:arm\n"));
+	g_free(filtered);
+
+	g_assert_cmpint(remmina_rdpw_classify("full address:s:host.rdp.test\r"
+					      "resourceprovider:s:arm\r"
+					      "gatewayhostname:s:gateway.rdp.test\n"), ==,
+			REMMINA_RDPW_AVD);
+	g_assert_cmpint(remmina_rdpw_classify("full address:s:host.rdp.test\r"
+					      "resourceprovider:s:arm\n"), ==,
+			REMMINA_RDPW_AVD_WITHOUT_GATEWAY);
+}
+
+int main(int argc, char *argv[])
+{
+	g_test_init(&argc, &argv, NULL);
+	if (argc < 2) {
+		g_printerr("usage: %s FIXTURE\n", argv[0]);
+		return 2;
+	}
+	fixture_path = argv[1];
+	g_test_add_func("/rdpw/read-file/fixture", test_read_file_accepts_the_fixture);
+	g_test_add_func("/rdpw/read-file/symlink", test_read_file_refuses_a_symbolic_link);
+	g_test_add_func("/rdpw/read-file/directory", test_read_file_refuses_a_directory);
+	g_test_add_func("/rdpw/read-file/oversized", test_read_file_refuses_an_oversized_file);
+	g_test_add_func("/rdpw/decode/utf16", test_utf16_and_utf8_decode_alike);
+	g_test_add_func("/rdpw/decode/invalid", test_invalid_text_is_refused);
+	g_test_add_func("/rdpw/decode/embedded-nul", test_embedded_nul_text_is_refused);
+	g_test_add_func("/rdpw/classify", test_classify_reads_the_routing_keys);
+	g_test_add_func("/rdpw/allowlist/keys", test_allowlist_keeps_only_routing_settings);
+	g_test_add_func("/rdpw/allowlist/arguments", test_allowlist_refuses_embedded_arguments);
+	g_test_add_func("/rdpw/allowlist/carriage-return", test_a_carriage_return_hides_nothing);
+	return g_test_run();
+}
