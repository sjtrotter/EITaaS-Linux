+	if (token_uri) {
 		if (g_str_equal(token_uri, AUTH_CANCELLED))
 		{
 			rc = FALSE;
+			g_free(token_uri);
 			goto cleanup;
 		}
 
 		char* code = extract_authorization_code(token_uri);
 		if (!code) {
+			g_free(token_uri);
 			goto cleanup;
 		}
 
@@ -503,11 +542,12 @@ static BOOL remmina_rdp_get_avd_access_token(freerdp* instance, char** token) {
 					"grant_type=authorization_code&code=%s&client_id=%s&scope=%s&redirect_uri=%s&code_verifier=%s", code,
 					client_id, scope, redirect_uri, pkce_verifier) <= 0)
 		{
+			g_free(token_uri);
 			goto cleanup;
 		}
 
 		rc = client_common_get_access_token(instance, token_request, token);
-		break;
+		g_free(token_uri);
 	}
 
 cleanup:
@@ -520,9 +560,6 @@ cleanup:
 	free(pkce_challenge);
 	g_free(expected_redirect);
 	SET_AUTH_URI(gp, NULL);
-	SET_TOKEN_URI(gp, NULL);
