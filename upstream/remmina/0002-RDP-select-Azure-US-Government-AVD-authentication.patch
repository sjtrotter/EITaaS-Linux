 		time(&(rfi->last_time)); //update last user interaction time
@@ -1756,6 +1748,50 @@ static gboolean remmina_rdp_main(RemminaProtocolWidget *gp)
 	channels = rfi->clientContext.context.channels;
 
 	remminafile = remmina_plugin_service->protocol_plugin_get_file(gp);
+	const gchar *rdpw_path = remmina_plugin_service->file_get_string(remminafile, "rdpw_path");
+	const gchar *rdpw_digest = remmina_plugin_service->file_get_string(remminafile, "rdpw_sha256");
+	if (rdpw_path) {
+		gchar *contents = NULL;
+		gsize length = 0;
+		gchar *digest = NULL;
+		if (!rdpw_digest || !remmina_rdp_file_read_protected(
+		                         rdpw_path, &contents, &length, NULL)) {
+			g_free(contents);
+			REMMINA_PLUGIN_ERROR("Could not safely load the protected RDPW profile");
+			return FALSE;
+		}
+		digest = g_compute_checksum_for_data(G_CHECKSUM_SHA256,
+		    (const guchar *)contents, length);
+		if (g_strcmp0(digest, rdpw_digest) != 0 ||
+		    freerdp_client_settings_parse_connection_file_buffer(
+		        rfi->clientContext.context.settings, (const BYTE *)contents, length) != 0) {
+			g_free(digest);
+			g_free(contents);
+			REMMINA_PLUGIN_ERROR("Protected RDPW profile changed after import or is invalid");
+			return FALSE;
+		}
+		g_free(digest);
+		g_free(contents);
+
+		const gchar *gateway = freerdp_settings_get_string(
+		    rfi->clientContext.context.settings, FreeRDP_GatewayHostname);
+		if (gateway && g_str_has_suffix(gateway, ".wvd.azure.us")) {
+			if (!freerdp_settings_set_string(rfi->clientContext.context.settings,
+			                                 FreeRDP_GatewayAzureActiveDirectory,
+			                                 "login.microsoftonline.us") ||
+			    !freerdp_settings_set_string(rfi->clientContext.context.settings,
+			                                 FreeRDP_GatewayAvdScope,
