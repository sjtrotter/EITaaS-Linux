From 44db83125bf6386f91f0fa7a1981639633281ad6 Mon Sep 17 00:00:00 2001
From: Stephen Trotter <33046718+sjtrotter@users.noreply.github.com>
Date: Sun, 30 Aug 2026 12:04:23 -0500
Subject: [PATCH 2/7] RDP: select Azure US Government AVD authentication

FreeRDP defaults the AVD OAuth authority, scope, and redirect format to
the commercial cloud. A protected profile whose gateway lives in the
public Azure US Government namespace (*.wvd.azure.us) therefore failed
authentication against login.microsoftonline.us.

Collect the public constants of every supported cloud in one table,
rdp_avd_cloud.h: the gateway namespace that identifies the cloud and the
authority, scope, and redirect format FreeRDP's AVD token path reads. The
commercial cloud FreeRDP defaults to is the first entry, so the same table
describes both what a profile gets by default and what a gateway host in
another namespace selects.

When the gateway host parsed from the profile belongs to a cloud in that
table, apply its authority, scope, and redirect format and enable
tenant-specific authorization. An authority that is not FreeRDP's default
was configured on purpose, so it and the settings around it are used as
they are instead of being replaced; only the defaults are selected over.
Nothing is copied from the profile: the gateway suffix decides which row
of public constants applies.

Tested with FreeRDP 3.30.0. The series requires FreeRDP 3.16.0 or
newer: FreeRDP_GatewayAvdScope and FreeRDP_GatewayAvdAccessAadFormat
were added in that release, and every other API used is older.

This change was prepared with AI assistance (Claude, Anthropic) and was
reviewed and tested by the author.
---
 plugins/rdp/CMakeLists.txt  |  1 +
 plugins/rdp/rdp_avd_cloud.h | 82 +++++++++++++++++++++++++++++++++++++
 plugins/rdp/rdp_plugin.c    | 31 ++++++++++++++
 3 files changed, 114 insertions(+)
 create mode 100644 plugins/rdp/rdp_avd_cloud.h

diff --git a/plugins/rdp/CMakeLists.txt b/plugins/rdp/CMakeLists.txt
index 5904c5780..3068a6bed 100644
--- a/plugins/rdp/CMakeLists.txt
+++ b/plugins/rdp/CMakeLists.txt
@@ -47,6 +47,7 @@ set(REMMINA_PLUGIN_RDP_SRCS
     rdp_file.h
     rdp_rdpw.c
     rdp_rdpw.h
+    rdp_avd_cloud.h
     rdp_settings.c
     rdp_settings.h
     rdp_graphics.c
diff --git a/plugins/rdp/rdp_avd_cloud.h b/plugins/rdp/rdp_avd_cloud.h
new file mode 100644
index 000000000..283c26f8e
--- /dev/null
+++ b/plugins/rdp/rdp_avd_cloud.h
@@ -0,0 +1,82 @@
+/*
+ * Remmina - The GTK+ Remote Desktop Client
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#pragma once
+
+#include <glib.h>
+
+G_BEGIN_DECLS
+
+/*
+ * The public OAuth constants of the Azure clouds whose Azure Virtual Desktop
+ * gateways this client authenticates to: gateway_suffix is the public gateway
+ * namespace that identifies the cloud, and authority, scope and
+ * redirect_format are the values FreeRDP's AVD token path reads from
+ * FreeRDP_GatewayAzureActiveDirectory, FreeRDP_GatewayAvdScope and
+ * FreeRDP_GatewayAvdAccessAadFormat. Nothing here comes from a profile.
+ *
+ * redirect_format is a winpr_asprintf() format string that is passed the
+ * authority and the tenant, in that order; keep every entry a literal using
+ * at most those two %s conversions, in that order, and no other conversion,
+ * so that no setting can reach a format argument.
+ */
+typedef struct {
+	const char *	gateway_suffix;
+	const char *	authority;
+	const char *	scope;
+	const char *	redirect_format;
+} RemminaAvdCloud;
+
+/* FreeRDP's default redirect format, accepted in every cloud. */
+#define REMMINA_AVD_REDIRECT_DYNAMIC "https%%3A%%2F%%2F%s%%2F%s%%2Foauth2%%2Fnativeclient"
+
+/*
+ * Every supported cloud. The first entry is the commercial cloud FreeRDP
+ * defaults to and has no gateway suffix of its own: it is what a profile gets
+ * when no other cloud claims its gateway host.
+ */
+static inline const RemminaAvdCloud *remmina_avd_clouds(gsize *count)
+{
+	static const RemminaAvdCloud clouds[] = {
+		{
+			NULL,
+			"login.microsoftonline.com",
+			"https%3A%2F%2Fwww.wvd.microsoft.com%2F.default%20openid%20profile%20offline_access",
+			REMMINA_AVD_REDIRECT_DYNAMIC
+		},
+		{
+			".wvd.azure.us",
+			"login.microsoftonline.us",
+			"https%3A%2F%2Fwww.wvd.azure.us%2F.default%20openid%20profile%20offline_access",
+			"https%%3A%%2F%%2Flogin.microsoftonline.com%%2Fcommon%%2Foauth2%%2Fnativeclient"
+		}
+	};
+
+	if (count)
+		*count = G_N_ELEMENTS(clouds);
+	return clouds;
+}
+
+/* The commercial cloud, which FreeRDP configures a fresh rdpSettings with. */
+static inline const RemminaAvdCloud *remmina_avd_default_cloud(void)
+{
+	return remmina_avd_clouds(NULL);
+}
+
+/* The cloud whose public gateway namespace holds host, or NULL. */
+static inline const RemminaAvdCloud *remmina_avd_cloud_for_gateway(const char *host)
+{
+	gsize count = 0;
+	const RemminaAvdCloud *clouds = remmina_avd_clouds(&count);
+
+	if (!host)
+		return NULL;
+	for (gsize i = 0; i < count; i++)
+		if (clouds[i].gateway_suffix && g_str_has_suffix(host, clouds[i].gateway_suffix))
+			return &clouds[i];
+	return NULL;
+}
+
+G_END_DECLS
diff --git a/plugins/rdp/rdp_plugin.c b/plugins/rdp/rdp_plugin.c
index b7ffc5e95..c760aca0c 100644
--- a/plugins/rdp/rdp_plugin.c
+++ b/plugins/rdp/rdp_plugin.c
@@ -40,6 +40,7 @@
 
 #include "remmina/plugin.h"
 #include "rdp_plugin.h"
+#include "rdp_avd_cloud.h"
 #include "rdp_rdpw.h"
 #include "rdp_event.h"
 #include "rdp_graphics.h"
@@ -1784,6 +1785,36 @@ static gboolean remmina_rdp_main(RemminaProtocolWidget *gp)
 			return FALSE;
 		}
 		g_free(filtered);
+
+		rdpSettings *rdpw_settings = rfi->clientContext.context.settings;
+		const RemminaAvdCloud *cloud = remmina_avd_cloud_for_gateway(
+			freerdp_settings_get_string(rdpw_settings, FreeRDP_GatewayHostname));
+		if (cloud) {
+			const gchar *authority = freerdp_settings_get_string(
+				rdpw_settings, FreeRDP_GatewayAzureActiveDirectory);
+
+			/*
+			 * Anything but FreeRDP's own default was chosen on purpose;
+			 * use it rather than replacing it with the cloud selected
+			 * from the gateway host.
+			 */
+			if (g_strcmp0(authority, remmina_avd_default_cloud()->authority) != 0) {
+				REMMINA_PLUGIN_DEBUG("avd-cloud: keeping the configured authority");
+			} else if (!freerdp_settings_set_string(rdpw_settings,
+								FreeRDP_GatewayAzureActiveDirectory,
+								cloud->authority) ||
+				   !freerdp_settings_set_string(rdpw_settings, FreeRDP_GatewayAvdScope,
+								cloud->scope) ||
+				   !freerdp_settings_set_string(rdpw_settings,
+								FreeRDP_GatewayAvdAccessAadFormat,
+								cloud->redirect_format) ||
+				   !freerdp_settings_set_bool(rdpw_settings,
+							      FreeRDP_GatewayAvdUseTenantid, TRUE)) {
+				remmina_plugin_service->protocol_plugin_set_error(
+					gp, "%s", _("Could not configure Azure Virtual Desktop authentication."));
+				return FALSE;
+			}
+		}
 	}
 
 	gchar* ddir = remmina_plugin_service->file_get_user_datadir();
