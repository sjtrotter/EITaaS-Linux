From: EITaaS-Linux contributors <noreply@example.invalid>
Subject: [PATCH] Add PKCS11 certificate and PIN handling to AAD WebView

Handle WebKitGTK client-certificate challenges with PKCS11-backed
credentials. Keep the private key on the smart card, retain the PIN only
for the WebKit session, avoid shell invocation, and disable core dumps
before authentication material enters process memory.

--- a/client/SDL/common/aad/webview_impl.cpp
+++ b/client/SDL/common/aad/webview_impl.cpp
@@ -18,6 +18,7 @@
  */
 
 #include <webview.h>
+#include <webkit2/webkit2.h>
 
 #include "webview_impl.hpp"
 #include <algorithm>
@@ -29,11 +30,229 @@
 #include <string>
+#include <unordered_map>
 #include <vector>
 
+#include <sys/prctl.h>
+#include <sys/resource.h>
+
 #include <freerdp/log.h>
 #include <winpr/string.h>
 
 #define TAG FREERDP_TAG("client.SDL.common.aad")
 
+struct pkcs11_certificate
+{
+	std::string label;
+	std::string certificate_uri;
+	std::string private_key_uri;
+};
+
+static std::vector<std::string> command_lines(const std::vector<std::string>& arguments)
+{
+	std::vector<char*> argv;
+	for (const auto& item : arguments)
+		argv.push_back(const_cast<char*>(item.c_str()));
+	argv.push_back(nullptr);
+	gchar* output = nullptr;
+	gint status = 0;
+	GError* error = nullptr;
+	std::vector<std::string> lines;
+	if (g_spawn_sync(nullptr, argv.data(), nullptr, G_SPAWN_STDERR_TO_DEV_NULL, nullptr, nullptr,
+	                 &output, nullptr, &status, &error) && status == 0 && output)
+	{
+		gchar** split = g_strsplit(output, "\n", -1);
+		for (gchar** line = split; line && *line; line++)
+			if (g_str_has_prefix(*line, "pkcs11:"))
+				lines.emplace_back(*line);
+		g_strfreev(split);
+	}
+	if (error)
+		g_error_free(error);
+	g_free(output);
+	return lines;
+}
+
+static std::string uri_attribute(const std::string& uri, const std::string& name)
+{
+	const std::string needle = name + "=";
+	size_t start = uri.compare(0, 7, "pkcs11:") == 0 ? 7 : 0;
+	while (start < uri.size())
+	{
+		const auto end = uri.find(';', start);
+		const auto field = uri.substr(start, end == std::string::npos ? std::string::npos : end - start);
+		if (field.compare(0, needle.size(), needle) == 0)
+			return field.substr(needle.size());
+		if (end == std::string::npos)
+			break;
+		start = end + 1;
+	}
+	return {};
+}
+
+static std::string uri_label(const std::string& uri)
+{
+	const auto encoded = uri_attribute(uri, "object");
+	if (encoded.empty())
+		return "Smart-card authentication certificate";
+	gchar* decoded = g_uri_unescape_string(encoded.c_str(), nullptr);
+	std::string label = decoded && *decoded ? decoded : "Smart-card authentication certificate";
+	g_free(decoded);
+	return label;
+}
+
+static bool authentication_label(const std::string& label)
+{
+	std::string normalized = label;
+	std::transform(normalized.begin(), normalized.end(), normalized.begin(),
+	               [](unsigned char value) { return static_cast<char>(std::tolower(value)); });
+	return normalized.find("piv") != std::string::npos ||
+	       normalized.find("auth") != std::string::npos ||
+	       normalized.find("identity") != std::string::npos;
+}
+
+static std::string private_key_selector(const std::string& certificate_uri)
+{
+	const auto query = certificate_uri.find('?');
+	const auto attributes = certificate_uri.substr(0, query);
+	const auto suffix =
+	    query == std::string::npos ? std::string{} : certificate_uri.substr(query);
+	std::string result = "pkcs11:";
+	size_t start = attributes.compare(0, 7, "pkcs11:") == 0 ? 7 : 0;
+	bool first = true;
+	while (start < attributes.size())
+	{
+		const auto end = attributes.find(';', start);
+		const auto field = attributes.substr(
+		    start, end == std::string::npos ? std::string::npos : end - start);
+		if (field.compare(0, 7, "object=") != 0 && field.compare(0, 5, "type=") != 0)
+		{
+			if (!first)
+				result += ';';
+			result += field;
+			first = false;
+		}
+		if (end == std::string::npos)
+			break;
+		start = end + 1;
+	}
+	result += first ? "type=private" : ";type=private";
+	return result + suffix;
+}
+
+static std::vector<pkcs11_certificate> enumerate_certificates()
+{
+	std::vector<pkcs11_certificate> result;
+	for (const auto& token : command_lines({ "/usr/bin/p11tool", "--list-token-urls" }))
+	{
+		std::unordered_map<std::string, std::string> private_keys;
+		for (const auto& uri :
+		     command_lines({ "/usr/bin/p11tool", "--list-privkeys", "--only-urls", token }))
+		{
+			const auto id = uri_attribute(uri, "id");
+			if (!id.empty())
+				private_keys.emplace(id, uri);
+		}
+		for (const auto& uri :
+		     command_lines({ "/usr/bin/p11tool", "--list-certs", "--only-urls", token }))
+		{
+			const auto id = uri_attribute(uri, "id");
+			const auto key = private_keys.find(id);
+			if (id.empty())
+				continue;
+			const auto label = uri_label(uri);
+			if (authentication_label(label))
+				result.push_back(
+				    { label, uri, key == private_keys.end() ? private_key_selector(uri)
+				                                                   : key->second });
+		}
+	}
+	return result;
+}
+
+static gboolean webview_authenticate(WebKitWebView*, WebKitAuthenticationRequest* request,
+	                                 gpointer parent_data)
+{
+	const auto scheme = webkit_authentication_request_get_scheme(request);
+	const auto retry = webkit_authentication_request_is_retry(request);
+	WLog_INFO(TAG, "[Webview] TLS authentication challenge scheme=%d retry=%d",
+	          static_cast<int>(scheme), static_cast<int>(retry));
+	auto* parent = GTK_WINDOW(parent_data);
+	if (scheme == WEBKIT_AUTHENTICATION_SCHEME_CLIENT_CERTIFICATE_REQUESTED)
+	{
+		const auto certificates = enumerate_certificates();
+		if (certificates.empty())
+		{
+			WLog_ERR(TAG, "[Webview] no matching authentication certificate and private key found");
+			webkit_authentication_request_cancel(request);
+			return TRUE;
+		}
+		GtkWidget* dialog = gtk_dialog_new_with_buttons(
+		    "Select smart-card authentication certificate", parent, GTK_DIALOG_MODAL, "Cancel",
+		    GTK_RESPONSE_CANCEL, "Continue", GTK_RESPONSE_ACCEPT, nullptr);
+		GtkWidget* combo = gtk_combo_box_text_new();
+		for (const auto& certificate : certificates)
+			gtk_combo_box_text_append_text(GTK_COMBO_BOX_TEXT(combo), certificate.label.c_str());
+		gtk_combo_box_set_active(GTK_COMBO_BOX(combo), 0);
+		gtk_container_add(GTK_CONTAINER(gtk_dialog_get_content_area(GTK_DIALOG(dialog))), combo);
+		gtk_widget_show_all(dialog);
+		const gint response = gtk_dialog_run(GTK_DIALOG(dialog));
+		const gint selected = gtk_combo_box_get_active(GTK_COMBO_BOX(combo));
+		if (response != GTK_RESPONSE_ACCEPT || selected < 0 ||
+		    static_cast<size_t>(selected) >= certificates.size())
+		{
+			gtk_widget_destroy(dialog);
+			webkit_authentication_request_cancel(request);
+			return TRUE;
+		}
+		const auto& choice = certificates[static_cast<size_t>(selected)];
+		GError* error = nullptr;
+		GTlsCertificate* certificate = g_tls_certificate_new_from_pkcs11_uris(
+		    choice.certificate_uri.c_str(), choice.private_key_uri.c_str(), &error);
+		gtk_widget_destroy(dialog);
+		if (!certificate)
+		{
+			WLog_ERR(TAG, "[Webview] could not open selected PKCS11 certificate credential");
+			if (error)
+				g_error_free(error);
+			webkit_authentication_request_cancel(request);
+			return TRUE;
+		}
+		WebKitCredential* credential = webkit_credential_new_for_certificate(
+		    certificate, WEBKIT_CREDENTIAL_PERSISTENCE_NONE);
+		webkit_authentication_request_authenticate(request, credential);
+		webkit_credential_free(credential);
+		g_object_unref(certificate);
+		WLog_INFO(TAG, "[Webview] submitted PKCS11 client-certificate credential");
+		return TRUE;
+	}
+	if (scheme == WEBKIT_AUTHENTICATION_SCHEME_CLIENT_CERTIFICATE_PIN_REQUESTED)
+	{
+		GtkWidget* dialog = gtk_dialog_new_with_buttons(
+		    "Smart-card PIN", parent, GTK_DIALOG_MODAL, "Cancel", GTK_RESPONSE_CANCEL,
+		    "Continue", GTK_RESPONSE_ACCEPT, nullptr);
+		GtkWidget* entry = gtk_entry_new();
+		gtk_entry_set_visibility(GTK_ENTRY(entry), FALSE);
+		gtk_entry_set_input_purpose(GTK_ENTRY(entry), GTK_INPUT_PURPOSE_PIN);
+		gtk_container_add(GTK_CONTAINER(gtk_dialog_get_content_area(GTK_DIALOG(dialog))), entry);
+		gtk_widget_show_all(dialog);
+		const gint response = gtk_dialog_run(GTK_DIALOG(dialog));
+		if (response == GTK_RESPONSE_ACCEPT)
+		{
+			const gchar* pin = gtk_entry_get_text(GTK_ENTRY(entry));
+			WebKitCredential* credential = webkit_credential_new_for_certificate_pin(
+			    pin, WEBKIT_CREDENTIAL_PERSISTENCE_NONE);
+			webkit_authentication_request_authenticate(request, credential);
+			webkit_credential_free(credential);
+			gtk_entry_set_text(GTK_ENTRY(entry), "");
+			WLog_INFO(TAG, "[Webview] submitted certificate PIN credential");
+		}
+		else
+			webkit_authentication_request_cancel(request);
+		gtk_widget_destroy(dialog);
+		return TRUE;
+	}
+	return FALSE;
+}
+
 class fkt_arg
 {
   public:
@@ -157,7 +375,15 @@
 
 bool webview_impl_run(const std::string& title, const std::string& url, std::string& code)
 {
+	const struct rlimit no_core = { 0, 0 };
+	(void)setrlimit(RLIMIT_CORE, &no_core);
+	(void)prctl(PR_SET_DUMPABLE, 0, 0, 0, 0);
 	webview::webview w(false, nullptr);
+	auto controller = w.browser_controller();
+	auto window = w.window();
+	if (controller.ok() && window.ok())
+		g_signal_connect(WEBKIT_WEB_VIEW(controller.value()), "authenticate",
+		                 G_CALLBACK(webview_authenticate), window.value());
 
 	w.set_title(title);
 	w.set_size(800, 600, WEBVIEW_HINT_NONE);
