From: EITaaS-Linux contributors <noreply@example.invalid>
Subject: [PATCH] Do not log AAD URLs or callback parameters

OAuth callback URIs can contain authorization codes and error details. Avoid
placing any URI or parsed callback value in logs, including malformed input.

diff --git a/client/SDL/common/aad/webview_impl.cpp b/client/SDL/common/aad/webview_impl.cpp
index d4bfe4f..e72b450 100644
--- a/client/SDL/common/aad/webview_impl.cpp
+++ b/client/SDL/common/aad/webview_impl.cpp
@@ -43,10 +43,7 @@ class fkt_arg
 		auto redir = args.find("redirect_uri");
 		if (redir == args.end())
 		{
-			WLog_ERR(TAG,
-			         "[Webview] url %s does not contain a redirect_uri parameter, "
-			         "aborting.",
-			         url.c_str());
+			WLog_ERR(TAG, "[Webview] authorization request is missing a redirect URI");
 		}
 		else
 		{
@@ -80,15 +77,13 @@ class fkt_arg
 		auto err = _args.find("error");
 		if (err != _args.end())
 		{
-			auto suberr = _args.find("error_subcode");
-			WLog_ERR(TAG, "[Webview] %s: %s, %s: %s", err->first.c_str(), err->second.c_str(),
-			         suberr->first.c_str(), suberr->second.c_str());
+			WLog_ERR(TAG, "[Webview] authorization server returned an error");
 			return false;
 		}
 		auto val = _args.find("code");
 		if (val == _args.end())
 		{
-			WLog_ERR(TAG, "[Webview] no code parameter detected in redirect URI %s", uri.c_str());
+			WLog_ERR(TAG, "[Webview] callback did not contain an authorization code");
 			return false;
 		}
 
