#!/usr/bin/make -f

# Two binary packages share one pybuild build. With more than one package
# pybuild would install into the first python3-* package directory, so pin
# the destination to debian/tmp and let the *.install files split it.
# dh_python3 processes every package shipping /usr/lib/python3 files, so both
# eitaas-linux and eitaas-linux-gui receive ${python3:Depends}.
export PYBUILD_DESTDIR=debian/tmp

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_test:
	PYTHONPATH=$(CURDIR)/src python3 -m unittest discover -s tests -v
