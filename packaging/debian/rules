#!/usr/bin/make -f

# Two binary packages share one pybuild build: pybuild installs the wheel into
# debian/tmp and the *.install files split it. dh_python3 runs for every binary
# package that ships files under /usr/lib/python3/dist-packages, so both
# eitaas-linux and eitaas-linux-gui receive ${python3:Depends} without
# --package hints. The dist-info stays in eitaas-linux only.
%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_test:
	PYTHONPATH=$(CURDIR)/src python3 -m unittest discover -s tests -v
