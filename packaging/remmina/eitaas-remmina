set -eu

if [ "$#" -ne 1 ]; then
	echo "usage: eitaas-remmina PROFILE.rdpw" >&2
	exit 2
fi

case "$1" in
	*.rdpw) ;;
	*) echo "eitaas-remmina: profile must have an .rdpw extension" >&2; exit 2 ;;
esac

profile=$(readlink -f -- "$1")
state_home=${XDG_STATE_HOME:-"$HOME/.local/state"}
config_root=$state_home/eitaas-remmina
mkdir -p "$state_home"
[ -d "$config_root" ] || mkdir -m 700 "$config_root"
export XDG_CONFIG_HOME="$config_root"
export EITAAS_REMMINA_ONESHOT=1
# Remmina's REMMINA_PLUGIN_DEBUG lines are g_debug() in the "remmina" domain,
# which GLib drops unless the domain is enabled; the helper's session log and
# a terminal both need them. Remmina additionally appends its debug lines to
# $TMPDIR/remmina_log_file.log (upstream behaviour).
export G_MESSAGES_DEBUG="${G_MESSAGES_DEBUG:-remmina}"
# Deliberately no WLOG_LEVEL/WLOG_FILTER export. FreeRDP already reports
# gateway failures at WinPR's default INFO threshold -- the ARM response read
# gives "timeout [<n>ms] exceeded" at ERROR from com.freerdp.core.gateway.http
# and arm.c reports its own failures at ERROR -- and the applied wait is
# printed by the plugin's "avd-arm: response-timeout-ms=" debug line above.
# Raising the level would leak secrets: at DEBUG, com.freerdp.utils.http logs
# the whole OAuth token request body (the authorization code) and the whole
# token-endpoint response (access, refresh, and id tokens).

for client in \
	/usr/libexec/eitaas-remmina/bin/remmina \
	/usr/lib/eitaas-remmina/bin/remmina
do
	if [ -x "$client" ]; then
		# A private GApplication id keeps this one-shot client its own primary
		# instance: with the shared org.remmina.Remmina id, an already running
		# distribution Remmina would receive --connect and handle it without
		# the smart-card patches. Remmina passes G_APPLICATION_CAN_OVERRIDE_APP_ID.
		exec "$client" --gapplication-app-id=org.eitaas.Remmina --no-tray-icon --connect="$profile"
	fi
done

echo "eitaas-remmina: private Remmina client is not installed" >&2
exit 127
