set -eu

if [ "$#" -ne 1 ]; then
	echo "usage: eitaas-remmina PROFILE.rdpw" >&2
	exit 2
fi

case "$1" in
	*.rdpw) ;;
	*) echo "eitaas-remmina: profile must have an .rdpw extension" >&2; exit 2 ;;
esac

profile=$(readlink -f -- "$1")
config_root=${XDG_STATE_HOME:-"$HOME/.local/state"}/eitaas-remmina
mkdir -p -m 700 "$config_root"
export XDG_CONFIG_HOME="$config_root"
export EITAAS_REMMINA_ONESHOT=1

for client in \
	/usr/libexec/eitaas-remmina/bin/remmina \
	/usr/lib/eitaas-remmina/bin/remmina
do
	if [ -x "$client" ]; then
		exec "$client" --no-tray-icon --connect="$profile"
	fi
done

echo "eitaas-remmina: private Remmina client is not installed" >&2
exit 127
