--- a/plugins/rdp/rdp_web_auth.c
+++ b/plugins/rdp/rdp_web_auth.c
@@ -82,6 +82,36 @@
 #define GET_TOKEN_URI(gp) \
 	(gchar*) g_object_get_data(G_OBJECT(gp), "token-uri")
 
+static BOOL avd_oauth_settings_are_safe(const char* base, const char* tenantid,
+	                                    const char* client_id, const char* scope,
+	                                    const char* redirect_format)
+{
+	static const char commercial_scope[] =
+	    "https%3A%2F%2Fwww.wvd.microsoft.com%2F.default%20openid%20profile%20offline_access";
+	static const char government_scope[] =
+	    "https%3A%2F%2Fwww.wvd.azure.us%2F.default%20openid%20profile%20offline_access";
+	static const char dynamic_redirect[] =
+	    "https%%3A%%2F%%2F%s%%2F%s%%2Foauth2%%2Fnativeclient";
+	static const char avd_client_id[] = "a85cf173-4192-42f8-81fa-777a763e6e2c";
+	if (!base || !tenantid || !client_id || !scope || !redirect_format)
+		return FALSE;
+	if (strcmp(client_id, avd_client_id) != 0 || strlen(tenantid) > 128)
+		return FALSE;
+	for (const char *current = tenantid; *current; current++) {
+		if (!g_ascii_isalnum(*current) && *current != '-' && *current != '.')
+			return FALSE;
+	}
+	if (strcmp(base, "login.microsoftonline.com") == 0)
+		return strcmp(scope, commercial_scope) == 0 &&
+		       strcmp(redirect_format, dynamic_redirect) == 0;
+	if (strcmp(base, "login.microsoftonline.us") == 0)
+		return strcmp(scope, government_scope) == 0 &&
+		       (strcmp(redirect_format, dynamic_redirect) == 0 ||
+		        strcmp(redirect_format,
+		               "https%%3A%%2F%%2Flogin.microsoftonline.com%%2Fcommon%%2Foauth2%%2Fnativeclient") == 0);
+	return FALSE;
+}
+
 static char* extract_authorization_code(char* url)
 {
 	WINPR_ASSERT(url);
@@ -318,7 +348,8 @@
 	char* auth_uri = NULL;
 	size_t auth_uri_len = 0;
