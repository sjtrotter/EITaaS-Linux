From: EITaaS-Linux contributors <noreply@example.invalid>
Subject: [PATCH] Add smart card (PIV) authentication to the Remmina AAD WebView
License: GPL-2.0-or-later
Copyright: 2026 Stephen Trotter

--- a/plugins/rdp/CMakeLists.txt
+++ b/plugins/rdp/CMakeLists.txt
@@ -101,6 +101,15 @@ if(WITH_RDP_AUTH_AAD)
 
     if(FREERDP_HAS_AUTH_AAD AND WEBKIT2GTK_FOUND AND LIBSOUP_FOUND)
         message(STATUS "Enabling RDP AAD authentication.")
+        # Smart-card sign-in lists the card's certificates with GnuTLS'
+        # p11tool (package gnutls-bin or gnutls-utils). The packages pin the
+        # absolute path they depend on; an empty value searches PATH at run
+        # time.
+        set(REMMINA_P11TOOL "" CACHE STRING
+            "Absolute path of the p11tool binary, or empty to search PATH at run time")
+        if(REMMINA_P11TOOL)
+            add_definitions(-DREMMINA_P11TOOL="${REMMINA_P11TOOL}")
+        endif()
         # we cannot undefine WITH_AAD defined in FreeRDP so we use our own macro
         add_definitions(-DWITH_RDP_AUTH_AAD)
         include_directories(
--- a/plugins/rdp/rdp_web_auth.c
+++ b/plugins/rdp/rdp_web_auth.c
@@ -63,6 +63,10 @@ static BOOL remmina_sso_mib_try_access_token(freerdp *instance, AccessTokenType
 #include <freerdp/utils/aad.h>
 #include <winpr/wtypes.h>
 #include <winpr/wlog.h>
+#include <sys/prctl.h>
+#include <sys/resource.h>
+
+#include "eitaas_smartcard_auth.c"
 
 #define AUTH_CANCELLED "__AUTH_CANCELLED__"
 
@@ -163,6 +167,9 @@ static void remmina_rdp_webview_set_title(GtkWindow *dialog, RemminaProtocolWidg
 }
 
 static BOOL remmina_rdp_webview_show(RemminaProtocolWidget *gp) {
+	const struct rlimit no_core = { 0, 0 };
+	(void)setrlimit(RLIMIT_CORE, &no_core);
+	(void)prctl(PR_SET_DUMPABLE, 0, 0, 0, 0);
 	char* auth_uri = GET_AUTH_URI(gp);
 
 	GtkWidget *dialog = gtk_window_new(GTK_WINDOW_TOPLEVEL);
@@ -171,11 +178,26 @@ static BOOL remmina_rdp_webview_show(RemminaProtocolWidget *gp) {
 
 	WebKitWebView *webView = WEBKIT_WEB_VIEW(webkit_web_view_new());
 	gtk_container_add(GTK_CONTAINER(dialog), GTK_WIDGET(webView));
+	GUri *authentication_uri = g_uri_parse(auth_uri, G_URI_FLAGS_NONE, NULL);
+	const gchar *authentication_host = authentication_uri ? g_uri_get_host(authentication_uri) : NULL;
+	if (!authentication_host || g_uri_get_scheme(authentication_uri) == NULL ||
+	    g_ascii_strcasecmp(g_uri_get_scheme(authentication_uri), "https") != 0 ||
+	    (g_ascii_strcasecmp(authentication_host, "login.microsoftonline.com") != 0 &&
+	     g_ascii_strcasecmp(authentication_host, "login.microsoftonline.us") != 0)) {
+		if (authentication_uri)
+			g_uri_unref(authentication_uri);
+		gtk_widget_destroy(dialog);
+		return G_SOURCE_REMOVE;
+	}
+	g_object_set_data_full(G_OBJECT(webView), "rdp-authentication-host",
+	                       g_ascii_strdown(authentication_host, -1), g_free);
+	g_uri_unref(authentication_uri);
 
 	webkit_web_view_load_uri(webView, auth_uri);
 
 	g_signal_connect(dialog, "delete-event", G_CALLBACK(delete_event_cb), gp);
 	g_signal_connect(webView, "decide-policy", G_CALLBACK(decide_policy_cb), gp);
+	g_signal_connect(webView, "authenticate", G_CALLBACK(eitaas_webview_authenticate), dialog);
 
 	gtk_widget_show_all(dialog);
 
