From: EITaaS-Linux contributors <noreply@example.invalid>
Subject: [PATCH] Bind protected RDPW parsing to imported content
License: GPL-2.0-or-later
Copyright: 2026 Stephen Trotter

Reject symlinks and oversized profiles, record the digest observed during
import, and parse a verified immutable buffer exactly once before connection.

--- a/plugins/rdp/rdp_file.h
+++ b/plugins/rdp/rdp_file.h
@@ -38,9 +38,13 @@
 #include <glib.h>
 #include "common/remmina_plugin.h"
 
+#define REMMINA_RDPW_MAX_SIZE (1024 * 1024)
+
 G_BEGIN_DECLS
 
 gboolean remmina_rdp_file_import_test(RemminaFilePlugin *plugin, const gchar *from_file);
+gboolean remmina_rdp_file_read_protected(const gchar *path, gchar **contents,
+	                                     gsize *length, GError **error);
 RemminaFile *remmina_rdp_file_import(RemminaFilePlugin *plugin, const gchar *from_file);
 gboolean remmina_rdp_file_export_test(RemminaFilePlugin *plugin, RemminaFile *remminafile);
 gboolean remmina_rdp_file_export(RemminaFilePlugin *plugin, RemminaFile *remminafile, const gchar *to_file);
--- a/plugins/rdp/rdp_file.c
+++ b/plugins/rdp/rdp_file.c
@@ -38,6 +38,63 @@
 #include "rdp_plugin.h"
 #include "rdp_file.h"
 
+#include <glib/gstdio.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+gboolean remmina_rdp_file_read_protected(const gchar *path, gchar **contents,
+	                                     gsize *length, GError **error)
+{
+	g_return_val_if_fail(path && contents && length, FALSE);
+	*contents = NULL;
+	*length = 0;
+	int descriptor = g_open(path, O_RDONLY | O_CLOEXEC | O_NOFOLLOW, 0);
+	if (descriptor < 0) {
+		g_set_error(error, G_FILE_ERROR, g_file_error_from_errno(errno),
+		            "Could not open protected RDPW profile: %s", g_strerror(errno));
+		return FALSE;
+	}
+	GStatBuf status;
+	if (fstat(descriptor, &status) != 0 || !S_ISREG(status.st_mode) ||
+	    status.st_size < 0 || status.st_size > REMMINA_RDPW_MAX_SIZE) {
+		g_set_error_literal(error, G_FILE_ERROR, G_FILE_ERROR_INVAL,
+		                    "Protected RDPW profile is not a bounded regular file");
+		close(descriptor);
+		return FALSE;
+	}
+	gsize expected = (gsize)status.st_size;
+	gchar *buffer = g_malloc(expected + 1);
+	gsize offset = 0;
+	while (offset < expected) {
+		ssize_t count = read(descriptor, buffer + offset, expected - offset);
+		if (count < 0 && errno == EINTR)
+			continue;
+		if (count <= 0) {
+			g_set_error_literal(error, G_FILE_ERROR, G_FILE_ERROR_FAILED,
+			                    "Protected RDPW profile changed while being read");
+			g_free(buffer);
+			close(descriptor);
+			return FALSE;
+		}
+		offset += (gsize)count;
+	}
+	gchar extra;
+	ssize_t extra_count = read(descriptor, &extra, 1);
+	close(descriptor);
+	if (extra_count != 0) {
+		g_set_error_literal(error, G_FILE_ERROR, G_FILE_ERROR_FAILED,
+		                    "Protected RDPW profile changed while being read");
+		g_free(buffer);
+		return FALSE;
+	}
+	buffer[offset] = '\0';
+	*contents = buffer;
+	*length = offset;
+	return TRUE;
+}
+
 gboolean remmina_rdp_file_import_test(RemminaFilePlugin *plugin, const gchar *from_file)
 {
 	TRACE_CALL(__func__);
@@ -199,20 +256,59 @@
 	GIOChannel *channel;
 	GError *error = NULL;
 	RemminaFile *remminafile;
+	const gchar *extension = strrchr(from_file, '.');
+	gboolean protected_profile = extension && g_ascii_strcasecmp(extension, ".rdpw") == 0;
+	gchar *protected_contents = NULL;
+	gsize protected_length = 0;
+	gchar *protected_digest = NULL;
+
+	if (protected_profile) {
+		if (!remmina_rdp_file_read_protected(from_file, &protected_contents,
+		                                     &protected_length, &error)) {
+			g_clear_error(&error);
+			g_free(protected_contents);
+			return NULL;
+		}
+		protected_digest = g_compute_checksum_for_data(G_CHECKSUM_SHA256,
+		    (const guchar *)protected_contents, protected_length);
+	}
 
 	channel = g_io_channel_new_file(from_file, "r", &error);
 
 	if (channel == NULL) {
 		g_print("Failed to import %s: %s\n", from_file, error->message);
+		g_clear_error(&error);
+		g_free(protected_contents);
+		g_free(protected_digest);
 		return NULL;
 	}
 
 	remminafile = remmina_rdp_file_import_channel(channel);
 	g_io_channel_shutdown(channel, TRUE, &error);
-	if (remminafile && g_str_has_suffix(from_file, ".rdpw")) {
+	if (remminafile && protected_profile) {
+		gchar *verified_contents = NULL;
+		gsize verified_length = 0;
+		gchar *verified_digest = NULL;
+		if (!remmina_rdp_file_read_protected(from_file, &verified_contents,
+		                                     &verified_length, &error)) {
+			g_clear_error(&error);
+			remminafile = NULL;
+		} else {
+			verified_digest = g_compute_checksum_for_data(G_CHECKSUM_SHA256,
+			    (const guchar *)verified_contents, verified_length);
+			if (g_strcmp0(protected_digest, verified_digest) != 0)
+				remminafile = NULL;
+		}
+		g_free(verified_contents);
+		g_free(verified_digest);
+	}
+	if (remminafile && protected_profile) {
 		remmina_plugin_service->file_set_string(remminafile, "eitaas_rdpw_path", from_file);
+		remmina_plugin_service->file_set_string(remminafile, "eitaas_rdpw_sha256", protected_digest);
 		remmina_plugin_service->file_set_string(remminafile, "gwtransp", "arm");
 	}
+	g_free(protected_contents);
+	g_free(protected_digest);
 
 	return remminafile;
 }
