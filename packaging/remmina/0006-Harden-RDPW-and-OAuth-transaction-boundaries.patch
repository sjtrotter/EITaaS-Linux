+static gboolean rdpw_native_key_allowed(const gchar *key)
+{
+	static const gchar *const allowed[] = {
+		"full address", "alternate full address", "server port", "loadbalanceinfo",
+		"gatewayhostname", "gatewayusagemethod", "gatewayprofileusagemethod",
+		"gatewaycredentialssource", "promptcredentialonce", "resourceprovider",
+		"wvd endpoint pool", "geo", "armpath", "aadtenantid", "diagnosticserviceurl",
+		"hubdiscoverygeourl", "activityhint", "enablerdsaadauth", "authentication level",
+		"remoteapplicationmode", "remoteapplicationprogram", "remoteapplicationname",
+		"remoteapplicationguid", NULL
+	};
+	for (gsize i = 0; allowed[i]; i++) {
+		if (g_ascii_strcasecmp(key, allowed[i]) == 0)
+			return TRUE;
+	}
+	return FALSE;
+}
+
+static gchar *rdpw_native_settings_allowlist(const guchar *contents, gsize length, gsize *filtered_length)
+{
+	const gchar *source = (const gchar *)contents;
+	gsize source_length = length;
+	gchar *utf8 = NULL;
+	if (length >= 2 && contents[0] == 0xFF && contents[1] == 0xFE) {
+		source += 2;
+		source_length -= 2;
+		utf8 = g_convert(source, source_length, "UTF-8", "UTF-16LE", NULL, NULL, NULL);
+	} else if (length >= 2 && contents[0] == 0xFE && contents[1] == 0xFF) {
+		source += 2;
+		source_length -= 2;
+		utf8 = g_convert(source, source_length, "UTF-8", "UTF-16BE", NULL, NULL, NULL);
+	} else {
+		utf8 = g_strndup(source, source_length);
+	}
+	if (!utf8)
+		return NULL;
+
+	GString *filtered = g_string_sized_new(length);
+	gchar **lines = g_strsplit(utf8, "\n", -1);
+	for (gchar **line = lines; line && *line; line++) {
+		g_strchomp(*line);
+		if ((*line)[0] == '/') {
+			g_string_free(filtered, TRUE);
+			g_strfreev(lines);
+			g_free(utf8);
+			return NULL;
+		}
+		gchar *separator = strchr(*line, ':');
+		if (!separator)
+			continue;
+		gchar *key = g_strndup(*line, separator - *line);
+		if (rdpw_native_key_allowed(key))
+			g_string_append_printf(filtered, "%s\n", *line);
+		g_free(key);
+	}
+	g_strfreev(lines);
+	g_free(utf8);
+	*filtered_length = filtered->len;
+	return g_string_free(filtered, FALSE);
+}
