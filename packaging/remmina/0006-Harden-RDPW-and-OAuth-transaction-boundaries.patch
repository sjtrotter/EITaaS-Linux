+/*
+ * One interactive OAuth authorization. The worker thread that runs
+ * remmina_rdp_get_*_access_token() owns the transaction from creation until
+ * cleanup. The dialog holds a reference from creation until its "destroy"
+ * signal and each idle holds one while it is pending, so the callbacks bound
+ * to a dialog always act on the transaction that created it. The transaction
+ * keeps the protocol widget alive. "dialog" is only touched on the GTK
+ * thread; every other field is guarded by "mutex".
+ */
+typedef struct {
+	gint ref_count;
+	GMutex mutex;
+	GCond condition;
+	RemminaProtocolWidget *gp;
+	GtkWidget *dialog;
+	gboolean dialog_pending;
+	gchar *auth_uri;
+	gchar *token_uri;
+	gchar *expected_redirect;
+	gchar *state;
+	gboolean completed;
+	gboolean closed;
+} RemminaOAuthTransaction;
+
+static RemminaOAuthTransaction *oauth_transaction_ref(RemminaOAuthTransaction *transaction)
+{
+	g_atomic_int_inc(&transaction->ref_count);
+	return transaction;
+}
 
-#define SET_TOKEN_URI(gp, token_uri) \
-	g_object_set_data(G_OBJECT(gp), "token-uri", token_uri)
+static void oauth_transaction_unref(gpointer data)
+{
+	RemminaOAuthTransaction *transaction = data;
+
+	if (!transaction || !g_atomic_int_dec_and_test(&transaction->ref_count))
+		return;
+	g_mutex_clear(&transaction->mutex);
+	g_cond_clear(&transaction->condition);
+	g_free(transaction->auth_uri);
+	g_free(transaction->token_uri);
+	g_free(transaction->expected_redirect);
+	g_free(transaction->state);
+	g_object_unref(transaction->gp);
+	g_free(transaction);
+}
+
+static RemminaOAuthTransaction *oauth_transaction_new(RemminaProtocolWidget *gp, const gchar *auth_uri,
+						      const gchar *redirect, const gchar *state)
+{
+	RemminaOAuthTransaction *transaction = g_new0(RemminaOAuthTransaction, 1);
+
+	transaction->ref_count = 1;
+	g_mutex_init(&transaction->mutex);
+	g_cond_init(&transaction->condition);
+	transaction->gp = g_object_ref(gp);
+	transaction->auth_uri = g_strdup(auth_uri);
+	transaction->expected_redirect = g_strdup(redirect);
+	transaction->state = g_strdup(state);
+	return transaction;
+}
 
-#define GET_TOKEN_URI(gp) \
-	(gchar*) g_object_get_data(G_OBJECT(gp), "token-uri")
+/* Records the single terminal result of a transaction; later results are ignored. */
+static void oauth_transaction_complete(RemminaOAuthTransaction *transaction, const gchar *uri)
+{
+	g_mutex_lock(&transaction->mutex);
+	if (!transaction->completed) {
+		transaction->token_uri = g_strdup(uri);
+		transaction->completed = TRUE;
+		g_cond_broadcast(&transaction->condition);
+	}
+	g_mutex_unlock(&transaction->mutex);
+}
+
+static gchar *oauth_transaction_wait(RemminaOAuthTransaction *transaction)
+{
+	gint64 deadline = g_get_monotonic_time() + OAUTH_TRANSACTION_TIMEOUT;
+
+	g_mutex_lock(&transaction->mutex);
+	while (!transaction->completed &&
+	       g_cond_wait_until(&transaction->condition, &transaction->mutex, deadline)) {
+	}
+	if (!transaction->completed) {
+		transaction->token_uri = g_strdup(AUTH_CANCELLED);
+		transaction->completed = TRUE;
+	}
+	gchar *result = g_strdup(transaction->token_uri);
+	g_mutex_unlock(&transaction->mutex);
+	return result;
+}
+
+static void oauth_dialog_destroy_cb(GtkWidget *dialog, RemminaOAuthTransaction *transaction)
+{
+	g_mutex_lock(&transaction->mutex);
+	if (transaction->dialog == dialog)
+		transaction->dialog = NULL;
+	g_mutex_unlock(&transaction->mutex);
+	oauth_transaction_unref(transaction);
+}
+
+static gboolean oauth_transaction_close_idle(gpointer data)
+{
+	RemminaOAuthTransaction *transaction = data;
+
+	g_mutex_lock(&transaction->mutex);
+	GtkWidget *dialog = transaction->dialog;
+	transaction->dialog = NULL;
+	g_mutex_unlock(&transaction->mutex);
+	if (dialog)
+		gtk_widget_destroy(dialog);
+	g_mutex_lock(&transaction->mutex);
+	transaction->closed = TRUE;
+	g_cond_broadcast(&transaction->condition);
+	g_mutex_unlock(&transaction->mutex);
+	return G_SOURCE_REMOVE;
+}
+
+/*
+ * Ends the transaction from the worker thread: any dialog that is still open
+ * (for example after a timeout) is destroyed on the GTK thread and the worker
+ * waits, bounded, until that has happened. A dialog that has not been shown
+ * yet is never shown because the transaction is already completed, and no
+ * round-trip to the GTK thread is made when no dialog is live.
+ */
+static void oauth_transaction_close(RemminaOAuthTransaction *transaction)
+{
+	gint64 deadline = g_get_monotonic_time() + OAUTH_DIALOG_CLOSE_TIMEOUT;
+
+	oauth_transaction_complete(transaction, AUTH_CANCELLED);
+	g_mutex_lock(&transaction->mutex);
+	if (!transaction->dialog && !transaction->dialog_pending) {
+		g_mutex_unlock(&transaction->mutex);
+		return;
+	}
+	g_mutex_unlock(&transaction->mutex);
+	gdk_threads_add_idle_full(G_PRIORITY_DEFAULT_IDLE, oauth_transaction_close_idle,
+				  oauth_transaction_ref(transaction), oauth_transaction_unref);
+	g_mutex_lock(&transaction->mutex);
+	while (!transaction->closed &&
+	       g_cond_wait_until(&transaction->condition, &transaction->mutex, deadline)) {
+	}
+	g_mutex_unlock(&transaction->mutex);
+}
+
+static gboolean oauth_query_value(const gchar *query, const gchar *name, gchar **value)
+{
+	*value = NULL;
+	if (!query)
+		return FALSE;
+	gchar **parts = g_strsplit(query, "&", -1);
+	for (gchar **part = parts; part && *part; part++) {
+		gchar *separator = strchr(*part, '=');
+		if (!separator)
+			continue;
+		gchar *key = g_uri_unescape_segment(*part, separator, NULL);
+		if (g_strcmp0(key, name) == 0) {
+			g_free(key);
+			if (*value) {
+				g_clear_pointer(value, g_free);
+				g_strfreev(parts);
+				return FALSE;
+			}
+			*value = g_uri_unescape_string(separator + 1, NULL);
+			continue;
+		}
+		g_free(key);
+	}
+	g_strfreev(parts);
+	return *value != NULL;
+}
+
+static gboolean oauth_callback_matches(RemminaOAuthTransaction *transaction, const gchar *uri)
+{
+	const gchar *expected_uri = transaction->expected_redirect;
+	const gchar *expected_state = transaction->state;
+	GUri *actual = uri ? g_uri_parse(uri, G_URI_FLAGS_NONE, NULL) : NULL;
+	GUri *expected = expected_uri ? g_uri_parse(expected_uri, G_URI_FLAGS_NONE, NULL) : NULL;
+	gchar *state = NULL;
+	gchar *code = NULL;
+	gchar *oauth_error = NULL;
+	gboolean destination = actual && expected && g_uri_get_scheme(actual) &&
+		g_uri_get_scheme(expected) && g_uri_get_host(actual) && g_uri_get_host(expected) &&
+		g_ascii_strcasecmp(g_uri_get_scheme(actual), g_uri_get_scheme(expected)) == 0 &&
+		g_ascii_strcasecmp(g_uri_get_host(actual), g_uri_get_host(expected)) == 0 &&
+		g_uri_get_port(actual) == g_uri_get_port(expected) &&
+		g_strcmp0(g_uri_get_path(actual), g_uri_get_path(expected)) == 0 &&
+		g_uri_get_userinfo(actual) == NULL && g_uri_get_fragment(actual) == NULL;
+	gboolean state_ok = destination && oauth_query_value(g_uri_get_query(actual), "state", &state) &&
+		g_strcmp0(state, expected_state) == 0;
+	gboolean has_code = state_ok && oauth_query_value(g_uri_get_query(actual), "code", &code);
+	gboolean has_error = state_ok && oauth_query_value(g_uri_get_query(actual), "error", &oauth_error);
+	gboolean result = state_ok && (has_code != has_error);
+	g_free(state);
+	g_free(code);
+	g_free(oauth_error);
+	if (actual)
+		g_uri_unref(actual);
+	if (expected)
+		g_uri_unref(expected);
+	return result;
+}
+
+static gboolean oauth_pkce_new(gchar **state, gchar **verifier, gchar **challenge)
+{
+	guchar random_state[32];
+	guchar random_verifier[32];
+	if (winpr_RAND(random_state, sizeof(random_state)) < 0 ||
+	    winpr_RAND(random_verifier, sizeof(random_verifier)) < 0)
+		return FALSE;
+	*state = crypto_base64url_encode(random_state, sizeof(random_state));
+	*verifier = crypto_base64url_encode(random_verifier, sizeof(random_verifier));
+	if (!*state || !*verifier)
+		return FALSE;
+	guint8 digest[32];
+	gsize digest_length = sizeof(digest);
+	GChecksum *checksum = g_checksum_new(G_CHECKSUM_SHA256);
+	g_checksum_update(checksum, (const guchar *)*verifier, strlen(*verifier));
+	g_checksum_get_digest(checksum, digest, &digest_length);
+	g_checksum_free(checksum);
+	*challenge = crypto_base64url_encode(digest, digest_length);
+	return *challenge != NULL;
+}
 
