+static RemminaFile *remmina_rdp_file_import_buffer(const gchar *contents, gsize length)
+{
+	const gchar *source = contents;
+	gsize source_length = length;
+	gchar *utf8 = NULL;
+	GError *error = NULL;
+
+	if (length >= 2 && (guchar)contents[0] == 0xFF && (guchar)contents[1] == 0xFE) {
+		source = contents + 2;
+		source_length = length - 2;
+		utf8 = g_convert(source, source_length, "UTF-8", "UTF-16LE", NULL, NULL, &error);
+	} else if (length >= 2 && (guchar)contents[0] == 0xFE && (guchar)contents[1] == 0xFF) {
+		source = contents + 2;
+		source_length = length - 2;
+		utf8 = g_convert(source, source_length, "UTF-8", "UTF-16BE", NULL, NULL, &error);
+	} else {
+		utf8 = g_strndup(source, source_length);
+	}
+	if (!utf8) {
+		g_clear_error(&error);
+		return NULL;
+	}
+
+	RemminaFile *remminafile = remmina_plugin_service->file_new();
+	gchar **lines = g_strsplit(utf8, "\n", -1);
+	for (gchar **line = lines; line && *line; line++) {
+		g_strchomp(*line);
+		gchar *first = strchr(*line, ':');
+		if (!first)
+			continue;
+		*first++ = '\0';
+		gchar *second = strchr(first, ':');
+		if (second)
+			remmina_rdp_file_import_field(remminafile, *line, second + 1);
+	}
+	g_strfreev(lines);
+	g_free(utf8);
+
+	remmina_plugin_service->file_set_string(remminafile, "name",
+		remmina_plugin_service->file_get_string(remminafile, "server"));
+	remmina_plugin_service->file_set_string(remminafile, "protocol", "RDP");
+	return remminafile;
+}
