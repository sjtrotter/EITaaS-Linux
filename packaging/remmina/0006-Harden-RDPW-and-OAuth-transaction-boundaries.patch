+		g_free(protected_encoded);
+		return remminafile;
 	}
 
 	channel = g_io_channel_new_file(from_file, "r", &error);
@@ -278,37 +329,11 @@ RemminaFile *remmina_rdp_file_import(RemminaFilePlugin *plugin,const gchar *from
 	if (channel == NULL) {
 		g_print("Failed to import %s: %s\n", from_file, error->message);
 		g_clear_error(&error);
-		g_free(protected_contents);
-		g_free(protected_digest);
