# Maintainer: Stephen Trotter <sjtrotter@users.noreply.github.com>

pkgname=eitaas-remmina
pkgver=@PKGVER@
pkgrel=2
pkgdesc='Isolated Remmina AVD and CAC prototype for EITaaS'
arch=('x86_64')
url='https://github.com/sjtrotter/EITaaS-Linux'
license=('GPL-2.0-or-later' 'Apache-2.0' 'MIT')
depends=('curl' 'gnutls' 'gtk3' 'icu' 'jansson' 'json-c' 'json-glib' 'krb5' 'libsecret'
         'libsodium' 'libsoup3' 'libssh' 'openssl' 'opensc' 'pcsclite'
         'webkit2gtk-4.1')
makedepends=('cmake' 'ninja')
options=('!debug')
source=("$pkgname-$pkgver-source.tar.gz")
sha256sums=('@SHA256@')
_freerdp='FreeRDP-3.31.0'
_remmina='Remmina-030946c83fe1b7218a21b6d32f9c975b243b7031'
_prefix='/usr/lib/eitaas-remmina'

build() {
  local private_root="$srcdir/private-root"
  cmake -S "$_freerdp" -B freerdp-build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX="$_prefix" \
    -DCMAKE_INSTALL_LIBDIR=lib -DWITH_AAD=ON -DWITH_PCSC=ON \
    -DWITH_SSO_MIB=OFF -DWITH_CLIENT=ON -DWITH_CLIENT_SDL=OFF \
    -DWITH_X11=OFF -DWITH_WAYLAND=OFF -DWITH_SERVER=OFF \
    -DWITH_SAMPLE=OFF -DWITH_MANPAGES=OFF -DWITH_DOCUMENTATION=OFF \
    -DWITH_FUSE=OFF -DWITH_CUPS=OFF -DWITH_FFMPEG=OFF \
    -DWITH_SWSCALE=OFF -DWITH_CAIRO=OFF -DWITH_ALSA=OFF \
    -DWITH_PULSE=OFF -DWITH_JPEG=OFF -DWITH_GSM=OFF -DWITH_LAME=OFF \
    -DWITH_OPENH264=OFF
  cmake --build freerdp-build --parallel 1
  DESTDIR="$private_root" cmake --install freerdp-build

  cmake -S "$_remmina" -B remmina-build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX="$_prefix" \
    -DCMAKE_PREFIX_PATH="$private_root$_prefix" \
    -DCMAKE_BUILD_WITH_INSTALL_RPATH=ON \
    -DCMAKE_INSTALL_RPATH='$ORIGIN/../lib:$ORIGIN/..' \
    -DWITH_FREERDP3=ON -DWITH_RDP_AUTH_AAD=ON -DWITH_SSO_MIB=OFF \
    -DWITH_GCRYPT=OFF -DWITH_VTE=OFF -DHAVE_LIBAPPINDICATOR=OFF \
    -DWITH_CUPS=OFF -DWITH_AVAHI=OFF -DWITH_LIBVNCSERVER=OFF \
    -DWITH_SPICE=OFF -DWITH_NEWS=OFF -DWITH_STATS=OFF -DWITH_TIP=OFF \
    -DWITH_MANPAGES=OFF -DWITH_ICON_CACHE=OFF -DWITH_WWW=OFF \
    -DWITH_GVNC=OFF -DWITH_X2GO=OFF -DWITH_KF5WALLET=OFF -DWITH_ST=OFF \
    -DWITH_XDMCP=OFF -DWITH_NX=OFF -DWITH_PYTHONLIBS=OFF
  cmake --build remmina-build --parallel 1
}

check() {
  test -x remmina-build/src/remmina
  test -f remmina-build/plugins/rdp/remmina-plugin-rdp.so
  grep -a -q 'Select smart-card authentication certificate' \
    remmina-build/plugins/rdp/remmina-plugin-rdp.so
}

package() {
  DESTDIR="$pkgdir" cmake --install freerdp-build
  DESTDIR="$pkgdir" cmake --install remmina-build
  install -Dpm755 eitaas-remmina "$pkgdir/usr/bin/eitaas-remmina"

  local license_dir="$pkgdir/usr/share/licenses/$pkgname"
  install -Dpm644 "$_freerdp/LICENSE" "$license_dir/FreeRDP-LICENSE"
  install -Dpm644 "$_freerdp/winpr/libwinpr/sysinfo/cpufeatures/NOTICE" \
    "$license_dir/FreeRDP-cpufeatures-NOTICE"
  install -Dpm644 "$_remmina/COPYING" "$license_dir/Remmina-COPYING"
  install -Dpm644 "$_remmina/LICENSE" "$license_dir/Remmina-LICENSE"
  install -Dpm644 "$_remmina/LICENSE.OpenSSL" "$license_dir/Remmina-LICENSE.OpenSSL"
  install -Dpm644 EITaaS-LICENSE "$license_dir/EITaaS-LICENSE"
  install -Dpm644 THIRD_PARTY_NOTICES.md "$license_dir/THIRD_PARTY_NOTICES.md"
  install -Dpm644 sources.json "$pkgdir/usr/share/doc/$pkgname/sources.json"

  rm -rf "$pkgdir$_prefix/include" "$pkgdir$_prefix/lib/cmake" \
    "$pkgdir$_prefix/lib/pkgconfig" "$pkgdir$_prefix/share/man"
  rm -f "$pkgdir$_prefix"/lib/*.so
}
