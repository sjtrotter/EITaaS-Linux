#compdef eitaas

_arguments -C \
  '1:command:(doctor inspect-profile smartcard connect certificates)' \
  '*::argument:->args'

case $words[2] in
  doctor) _arguments '--json[emit JSON]' ;;
  inspect-profile) _arguments '1:profile:_files -g "*.rdp(w|)(.)"' '--json[emit JSON]' ;;
  smartcard) _arguments '1:command:(status)' '--json[emit JSON]' ;;
  connect)
    _arguments '1:profile:_files -g "*.rdp(w|)(.)"' \
      '--backend=[select backend]:backend:(auto x11 sdl wayland)' \
      '--clipboard[enable bidirectional clipboard]'
    ;;
  certificates) _arguments '1:command:(fetch inspect)' ;;
esac
